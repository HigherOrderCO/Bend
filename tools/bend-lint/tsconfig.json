{
  "compilerOptions": {
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "typeRoots": ["./node_modules/@types", "../../bend2/pack/node_modules/@types"],
    "paths": { "bend2/*": ["../../bend2/*"] }
  },
  "include": ["src", "rules"]
}
