  for ys: Bl3148
  Bl3148

def bcat3148(xs, ys):
  match xs:
    case Bn3148{}:
      ys
    case Bc3148{h, t}:
      Bc3148{h, bcat3148(t, ys)}

law blen3148:
  for xs: Bl3148
  Nat

def blen3148(xs):
  match xs:
    case Bn3148{}:
      Z{}
    case Bc3148{h, t}:
      S{blen3148(t)}

law bcat3148_nil:
  for xs: Bl3148
  {bcat3148(xs, Bn3148{}) == xs : Bl3148}

def bcat3148_nil(xs):
  match xs:
    case Bn3148{}:
      {==}
    case Bc3148{h, t}:
      %bcat3148_nil(t) : {Bc3148{h, bcat3148(t, Bn3148{})} == Bc3148{h, _} : Bl3148}
      {==}

law bcat3148_assoc:
  for xs: Bl3148
  for -ys: Bl3148
  for -zs: Bl3148
  {bcat3148(bcat3148(xs, ys), zs) == bcat3148(xs, bcat3148(ys, zs)) : Bl3148}

def bcat3148_assoc(xs, ys, zs):
  match xs:
    case Bn3148{}:
      {==}
    case Bc3148{h, t}:
      %bcat3148_assoc(t, ys, zs) : {Bc3148{h, bcat3148(bcat3148(t, ys), zs)} == Bc3148{h, _} : Bl3148}
      {==}

law blen3148_cat:
  for xs: Bl3148
  for -ys: Bl3148
  {add(blen3148(xs), blen3148(ys)) == blen3148(bcat3148(xs, ys)) : Nat}

def blen3148_cat(xs, ys):
  match xs:
    case Bn3148{}:
      {==}
    case Bc3148{h, t}:
      %blen3148_cat(t, ys) : {S{add(blen3148(t), blen3148(ys))} == S{_} : Nat}
      {==}

type Ct3149 is Data:
  Cl3149{val: Nat}
  Cn3149{lft: Ct3149, rgt: Ct3149}

law cmir3149:
  for t: Ct3149
  Ct3149

def cmir3149(t):
  match t:
    case Cl3149{v}:
      Cl3149{v}
    case Cn3149{l, r}:
      Cn3149{cmir3149(r), cmir3149(l)}

law csize3149:
  for t: Ct3149
  Nat

def csize3149(t):
  match t:
    case Cl3149{v}:
      S{Z{}}
    case Cn3149{l, r}:
      add(csize3149(l), csize3149(r))

law Ct3149.cpy:
  for t: Ct3149
  Pair(Cpy(Ct3149, t), Cpy(Ct3149, t))

law Ct3149.cpy.leaf:
  for -v: Nat
  for c: Pair(Cpy(Nat, v), Cpy(Nat, v))
  Pair(Cpy(Ct3149, Cl3149{v}), Cpy(Ct3149, Cl3149{v}))

def Ct3149.cpy.leaf(v, c):
  Tuple{Tuple{v1, e1}, Tuple{v2, e2}} = c
  Tuple{Tuple{Cl3149{v1}, cong(Nat, Ct3149, x => Cl3149{x}, v, v1, e1)}, Tuple{Cl3149{v2}, cong(Nat, Ct3149, x => Cl3149{x}, v, v2, e2)}}

law Ct3149.cpy.node:
  for -l: Ct3149
  for -r: Ct3149
  for cl: Pair(Cpy(Ct3149, l), Cpy(Ct3149, l))
  for cr: Pair(Cpy(Ct3149, r), Cpy(Ct3149, r))
  Pair(Cpy(Ct3149, Cn3149{l, r}), Cpy(Ct3149, Cn3149{l, r}))

def Ct3149.cpy.node(l, r, cl, cr):
  Tuple{Tuple{l1, el1}, Tuple{l2, el2}} = cl
  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn3149{l1, r1}, Equal.cong2(Ct3149, Ct3149, Ct3149, x => y => Cn3149{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn3149{l2, r2}, Equal.cong2(Ct3149, Ct3149, Ct3149, x => y => Cn3149{x, y}, l, l2, r, r2, el2, er2)}}

def Ct3149.cpy(t):
  match t:
    case Cl3149{v}:
      Ct3149.cpy.leaf(v, Nat.cpy(v))
    case Cn3149{l, r}:
      Ct3149.cpy.node(l, r, Ct3149.cpy(l), Ct3149.cpy(r))

law cmir3149_mir:
  for t: Ct3149
  {cmir3149(cmir3149(t)) == t : Ct3149}

def cmir3149_mir(t):
  match t:
    case Cl3149{v}:
      {==}
    case Cn3149{l, r}:
      %cmir3149_mir(l) : {Cn3149{cmir3149(cmir3149(l)), cmir3149(cmir3149(r))} == Cn3149{_, r} : Ct3149}
      %cmir3149_mir(r) : {Cn3149{cmir3149(cmir3149(l)), cmir3149(cmir3149(r))} == Cn3149{cmir3149(cmir3149(l)), _} : Ct3149}
      {==}

law csize3149_mir:
  for +t: Ct3149
  {csize3149(cmir3149(t)) == csize3149(t) : Nat}

def csize3149_mir(t):
  match t:
    case Cl3149{v}:
      {==}
    case Cn3149{l, r}:
      %csize3149_mir(r) : {add(csize3149(cmir3149(r)), csize3149(cmir3149(l))) == add(csize3149(l), _) : Nat}
      %csize3149_mir(l) : {add(csize3149(cmir3149(r)), csize3149(cmir3149(l))) == add(_, csize3149(cmir3149(r))) : Nat}
      %add_comm(csize3149(cmir3149(l)), csize3149(cmir3149(r))) : {_ == add(csize3149(cmir3149(l)), csize3149(cmir3149(r))) : Nat}
      {==}

type An3150 is Data:
  Az3150{}
  As3150{pred: An3150}

