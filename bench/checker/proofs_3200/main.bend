law bcat2860_assoc:
  for xs: Bl2860
  for -ys: Bl2860
  for -zs: Bl2860
  {bcat2860(bcat2860(xs, ys), zs) == bcat2860(xs, bcat2860(ys, zs)) : Bl2860}

