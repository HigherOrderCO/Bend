      %csize2642_mir(l) : {add(csize2642(cmir2642(r)), csize2642(cmir2642(l))) == add(_, csize2642(cmir2642(r))) : Nat}
      %add_comm(csize2642(cmir2642(l)), csize2642(cmir2642(r))) : {_ == add(csize2642(cmir2642(l)), csize2642(cmir2642(r))) : Nat}
