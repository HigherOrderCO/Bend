  match xs:
    case Bn1639{}:
      {==}
    case Bc1639{h, t}:
      %blen1639_cat(t, ys) : {S{add(blen1639(t), blen1639(ys))} == S{_} : Nat}
      {==}

type Ct1640 is Data:
  Cl1640{val: Nat}
  Cn1640{lft: Ct1640, rgt: Ct1640}

law cmir1640:
  for t: Ct1640
  Ct1640

