  Cn1163{lft: Ct1163, rgt: Ct1163}

law cmir1163:
  for t: Ct1163
  Ct1163

def cmir1163(t):
  match t:
    case Cl1163{v}:
      Cl1163{v}
    case Cn1163{l, r}:
      Cn1163{cmir1163(r), cmir1163(l)}

law csize1163:
  for t: Ct1163
  Nat

def csize1163(t):
  match t:
    case Cl1163{v}:
      S{Z{}}
    case Cn1163{l, r}:
      add(csize1163(l), csize1163(r))

law Ct1163.cpy:
  for t: Ct1163
  Pair(Cpy(Ct1163, t), Cpy(Ct1163, t))

law Ct1163.cpy.leaf:
  for -v: Nat
  for c: Pair(Cpy(Nat, v), Cpy(Nat, v))
  Pair(Cpy(Ct1163, Cl1163{v}), Cpy(Ct1163, Cl1163{v}))

def Ct1163.cpy.leaf(v, c):
  Tuple{Tuple{v1, e1}, Tuple{v2, e2}} = c
  Tuple{Tuple{Cl1163{v1}, cong(Nat, Ct1163, x => Cl1163{x}, v, v1, e1)}, Tuple{Cl1163{v2}, cong(Nat, Ct1163, x => Cl1163{x}, v, v2, e2)}}

law Ct1163.cpy.node:
  for -l: Ct1163
  for -r: Ct1163
  for cl: Pair(Cpy(Ct1163, l), Cpy(Ct1163, l))
  for cr: Pair(Cpy(Ct1163, r), Cpy(Ct1163, r))
  Pair(Cpy(Ct1163, Cn1163{l, r}), Cpy(Ct1163, Cn1163{l, r}))

def Ct1163.cpy.node(l, r, cl, cr):
  Tuple{Tuple{l1, el1}, Tuple{l2, el2}} = cl
  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn1163{l1, r1}, Equal.cong2(Ct1163, Ct1163, Ct1163, x => y => Cn1163{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn1163{l2, r2}, Equal.cong2(Ct1163, Ct1163, Ct1163, x => y => Cn1163{x, y}, l, l2, r, r2, el2, er2)}}

def Ct1163.cpy(t):
  match t:
    case Cl1163{v}:
      Ct1163.cpy.leaf(v, Nat.cpy(v))
    case Cn1163{l, r}:
      Ct1163.cpy.node(l, r, Ct1163.cpy(l), Ct1163.cpy(r))

law cmir1163_mir:
  for t: Ct1163
  {cmir1163(cmir1163(t)) == t : Ct1163}

def cmir1163_mir(t):
  match t:
    case Cl1163{v}:
      {==}
    case Cn1163{l, r}:
      %cmir1163_mir(l) : {Cn1163{cmir1163(cmir1163(l)), cmir1163(cmir1163(r))} == Cn1163{_, r} : Ct1163}
      %cmir1163_mir(r) : {Cn1163{cmir1163(cmir1163(l)), cmir1163(cmir1163(r))} == Cn1163{cmir1163(cmir1163(l)), _} : Ct1163}
      {==}

law csize1163_mir:
  for +t: Ct1163
  {csize1163(cmir1163(t)) == csize1163(t) : Nat}

def csize1163_mir(t):
  match t:
    case Cl1163{v}:
      {==}
    case Cn1163{l, r}:
      %csize1163_mir(r) : {add(csize1163(cmir1163(r)), csize1163(cmir1163(l))) == add(csize1163(l), _) : Nat}
      %csize1163_mir(l) : {add(csize1163(cmir1163(r)), csize1163(cmir1163(l))) == add(_, csize1163(cmir1163(r))) : Nat}
      %add_comm(csize1163(cmir1163(l)), csize1163(cmir1163(r))) : {_ == add(csize1163(cmir1163(l)), csize1163(cmir1163(r))) : Nat}
      {==}

type An1164 is Data:
  Az1164{}
  As1164{pred: An1164}

law aadd1164:
  for a: An1164
  for b: An1164
  An1164

def aadd1164(a, b):
  match a:
    case Az1164{}:
      b
    case As1164{a}:
      As1164{aadd1164(a, b)}

law An1164.cpy:
  for n: An1164
  Pair(Cpy(An1164, n), Cpy(An1164, n))

law An1164.cpy.succ:
  for -p: An1164
  for c: Pair(Cpy(An1164, p), Cpy(An1164, p))
  Pair(Cpy(An1164, As1164{p}), Cpy(An1164, As1164{p}))

def An1164.cpy.succ(p, c):
  Tuple{Tuple{a, ea}, Tuple{b, eb}} = c
  Tuple{Tuple{As1164{a}, cong(An1164, An1164, x => As1164{x}, p, a, ea)}, Tuple{As1164{b}, cong(An1164, An1164, x => As1164{x}, p, b, eb)}}

def An1164.cpy(n):
  match n:
    case Az1164{}:
      Tuple{Tuple{Az1164{}, {==}}, Tuple{Az1164{}, {==}}}
    case As1164{p}:
      An1164.cpy.succ(p, An1164.cpy(p))

law aadd1164_zero:
  for a: An1164
  {aadd1164(a, Az1164{}) == a : An1164}

def aadd1164_zero(a):
  match a:
    case Az1164{}:
      {==}
    case As1164{a}:
      %aadd1164_zero(a) : {As1164{aadd1164(a, Az1164{})} == As1164{_} : An1164}
      {==}

law aadd1164_succ:
  for a: An1164
  for -b: An1164
  {As1164{aadd1164(a, b)} == aadd1164(a, As1164{b}) : An1164}

def aadd1164_succ(a, b):
  match a:
    case Az1164{}:
      {==}
    case As1164{a}:
      %aadd1164_succ(a, b) : {As1164{As1164{aadd1164(a, b)}} == As1164{_} : An1164}
      {==}

law aadd1164_comm:
  for a: An1164
  for +b: An1164
  {aadd1164(a, b) == aadd1164(b, a) : An1164}

def aadd1164_comm(a, b):
  match a:
    case Az1164{}:
      %aadd1164_zero(b) : {_ == aadd1164(b, Az1164{}) : An1164}
      {==}
    case As1164{a}:
      %aadd1164_succ(b, a) : {As1164{aadd1164(a, b)} == _ : An1164}
      %aadd1164_comm(a, b) : {As1164{aadd1164(a, b)} == As1164{_} : An1164}
      {==}

