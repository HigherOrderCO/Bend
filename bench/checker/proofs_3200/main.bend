  for b: An2253
  An2253

def aadd2253(a, b):
  match a:
    case Az2253{}:
      b
    case As2253{a}:
      As2253{aadd2253(a, b)}

law An2253.cpy:
  for n: An2253
  Pair(Cpy(An2253, n), Cpy(An2253, n))

law An2253.cpy.succ:
  for -p: An2253
  for c: Pair(Cpy(An2253, p), Cpy(An2253, p))
  Pair(Cpy(An2253, As2253{p}), Cpy(An2253, As2253{p}))

def An2253.cpy.succ(p, c):
  Tuple{Tuple{a, ea}, Tuple{b, eb}} = c
  Tuple{Tuple{As2253{a}, cong(An2253, An2253, x => As2253{x}, p, a, ea)}, Tuple{As2253{b}, cong(An2253, An2253, x => As2253{x}, p, b, eb)}}

def An2253.cpy(n):
  match n:
    case Az2253{}:
      Tuple{Tuple{Az2253{}, {==}}, Tuple{Az2253{}, {==}}}
    case As2253{p}:
      An2253.cpy.succ(p, An2253.cpy(p))

law aadd2253_zero:
  for a: An2253
  {aadd2253(a, Az2253{}) == a : An2253}

def aadd2253_zero(a):
  match a:
    case Az2253{}:
      {==}
    case As2253{a}:
      %aadd2253_zero(a) : {As2253{aadd2253(a, Az2253{})} == As2253{_} : An2253}
      {==}

law aadd2253_succ:
  for a: An2253
  for -b: An2253
  {As2253{aadd2253(a, b)} == aadd2253(a, As2253{b}) : An2253}

def aadd2253_succ(a, b):
  match a:
    case Az2253{}:
      {==}
    case As2253{a}:
      %aadd2253_succ(a, b) : {As2253{As2253{aadd2253(a, b)}} == As2253{_} : An2253}
      {==}

law aadd2253_comm:
  for a: An2253
  for +b: An2253
  {aadd2253(a, b) == aadd2253(b, a) : An2253}

def aadd2253_comm(a, b):
  match a:
    case Az2253{}:
      %aadd2253_zero(b) : {_ == aadd2253(b, Az2253{}) : An2253}
      {==}
    case As2253{a}:
      %aadd2253_succ(b, a) : {As2253{aadd2253(a, b)} == _ : An2253}
      %aadd2253_comm(a, b) : {As2253{aadd2253(a, b)} == As2253{_} : An2253}
      {==}

type Bl2254 is Data:
  Bn2254{}
  Bc2254{head: Nat, tail: Bl2254}

law bcat2254:
  for xs: Bl2254
  for ys: Bl2254
  Bl2254

def bcat2254(xs, ys):
  match xs:
    case Bn2254{}:
      ys
    case Bc2254{h, t}:
      Bc2254{h, bcat2254(t, ys)}

law blen2254:
  for xs: Bl2254
  Nat

def blen2254(xs):
  match xs:
    case Bn2254{}:
      Z{}
    case Bc2254{h, t}:
      S{blen2254(t)}

law bcat2254_nil:
  for xs: Bl2254
  {bcat2254(xs, Bn2254{}) == xs : Bl2254}

def bcat2254_nil(xs):
  match xs:
    case Bn2254{}:
      {==}
    case Bc2254{h, t}:
      %bcat2254_nil(t) : {Bc2254{h, bcat2254(t, Bn2254{})} == Bc2254{h, _} : Bl2254}
      {==}

law bcat2254_assoc:
  for xs: Bl2254
  for -ys: Bl2254
  for -zs: Bl2254
  {bcat2254(bcat2254(xs, ys), zs) == bcat2254(xs, bcat2254(ys, zs)) : Bl2254}

def bcat2254_assoc(xs, ys, zs):
  match xs:
    case Bn2254{}:
      {==}
    case Bc2254{h, t}:
      %bcat2254_assoc(t, ys, zs) : {Bc2254{h, bcat2254(bcat2254(t, ys), zs)} == Bc2254{h, _} : Bl2254}
      {==}

law blen2254_cat:
  for xs: Bl2254
  for -ys: Bl2254
  {add(blen2254(xs), blen2254(ys)) == blen2254(bcat2254(xs, ys)) : Nat}

def blen2254_cat(xs, ys):
  match xs:
    case Bn2254{}:
      {==}
    case Bc2254{h, t}:
      %blen2254_cat(t, ys) : {S{add(blen2254(t), blen2254(ys))} == S{_} : Nat}
      {==}

type Ct2255 is Data:
  Cl2255{val: Nat}
  Cn2255{lft: Ct2255, rgt: Ct2255}

law cmir2255:
  for t: Ct2255
  Ct2255

def cmir2255(t):
  match t:
    case Cl2255{v}:
      Cl2255{v}
    case Cn2255{l, r}:
      Cn2255{cmir2255(r), cmir2255(l)}

law csize2255:
  for t: Ct2255
  Nat

def csize2255(t):
  match t:
    case Cl2255{v}:
      S{Z{}}
    case Cn2255{l, r}:
      add(csize2255(l), csize2255(r))

law Ct2255.cpy:
  for t: Ct2255
  Pair(Cpy(Ct2255, t), Cpy(Ct2255, t))

law Ct2255.cpy.leaf:
  for -v: Nat
  for c: Pair(Cpy(Nat, v), Cpy(Nat, v))
  Pair(Cpy(Ct2255, Cl2255{v}), Cpy(Ct2255, Cl2255{v}))

def Ct2255.cpy.leaf(v, c):
  Tuple{Tuple{v1, e1}, Tuple{v2, e2}} = c
  Tuple{Tuple{Cl2255{v1}, cong(Nat, Ct2255, x => Cl2255{x}, v, v1, e1)}, Tuple{Cl2255{v2}, cong(Nat, Ct2255, x => Cl2255{x}, v, v2, e2)}}

law Ct2255.cpy.node:
  for -l: Ct2255
  for -r: Ct2255
  for cl: Pair(Cpy(Ct2255, l), Cpy(Ct2255, l))
  for cr: Pair(Cpy(Ct2255, r), Cpy(Ct2255, r))
  Pair(Cpy(Ct2255, Cn2255{l, r}), Cpy(Ct2255, Cn2255{l, r}))

def Ct2255.cpy.node(l, r, cl, cr):
  Tuple{Tuple{l1, el1}, Tuple{l2, el2}} = cl
  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn2255{l1, r1}, Equal.cong2(Ct2255, Ct2255, Ct2255, x => y => Cn2255{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn2255{l2, r2}, Equal.cong2(Ct2255, Ct2255, Ct2255, x => y => Cn2255{x, y}, l, l2, r, r2, el2, er2)}}

def Ct2255.cpy(t):
  match t:
    case Cl2255{v}:
      Ct2255.cpy.leaf(v, Nat.cpy(v))
    case Cn2255{l, r}:
      Ct2255.cpy.node(l, r, Ct2255.cpy(l), Ct2255.cpy(r))

law cmir2255_mir:
  for t: Ct2255
  {cmir2255(cmir2255(t)) == t : Ct2255}

def cmir2255_mir(t):
  match t:
    case Cl2255{v}:
      {==}
    case Cn2255{l, r}:
      %cmir2255_mir(l) : {Cn2255{cmir2255(cmir2255(l)), cmir2255(cmir2255(r))} == Cn2255{_, r} : Ct2255}
      %cmir2255_mir(r) : {Cn2255{cmir2255(cmir2255(l)), cmir2255(cmir2255(r))} == Cn2255{cmir2255(cmir2255(l)), _} : Ct2255}
      {==}

law csize2255_mir:
  for +t: Ct2255
  {csize2255(cmir2255(t)) == csize2255(t) : Nat}

def csize2255_mir(t):
  match t:
    case Cl2255{v}:
      {==}
    case Cn2255{l, r}:
      %csize2255_mir(r) : {add(csize2255(cmir2255(r)), csize2255(cmir2255(l))) == add(csize2255(l), _) : Nat}
      %csize2255_mir(l) : {add(csize2255(cmir2255(r)), csize2255(cmir2255(l))) == add(_, csize2255(cmir2255(r))) : Nat}
      %add_comm(csize2255(cmir2255(l)), csize2255(cmir2255(r))) : {_ == add(csize2255(cmir2255(l)), csize2255(cmir2255(r))) : Nat}
      {==}

