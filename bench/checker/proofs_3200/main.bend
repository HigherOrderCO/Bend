  for -l: Ct1874
  for -r: Ct1874
  for cl: Pair(Cpy(Ct1874, l), Cpy(Ct1874, l))
  for cr: Pair(Cpy(Ct1874, r), Cpy(Ct1874, r))
  Pair(Cpy(Ct1874, Cn1874{l, r}), Cpy(Ct1874, Cn1874{l, r}))

