  match xs:
    case Bn2632{}:
      {==}
    case Bc2632{h, t}:
      %bcat2632_assoc(t, ys, zs) : {Bc2632{h, bcat2632(bcat2632(t, ys), zs)} == Bc2632{h, _} : Bl2632}
      {==}

law blen2632_cat:
  for xs: Bl2632
  for -ys: Bl2632
  {add(blen2632(xs), blen2632(ys)) == blen2632(bcat2632(xs, ys)) : Nat}

