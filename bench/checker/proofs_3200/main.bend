  Cn2987{lft: Ct2987, rgt: Ct2987}

law cmir2987:
  for t: Ct2987
  Ct2987

def cmir2987(t):
  match t:
    case Cl2987{v}:
      Cl2987{v}
    case Cn2987{l, r}:
      Cn2987{cmir2987(r), cmir2987(l)}

law csize2987:
  for t: Ct2987
  Nat

def csize2987(t):
  match t:
    case Cl2987{v}:
      S{Z{}}
    case Cn2987{l, r}:
      add(csize2987(l), csize2987(r))

law Ct2987.cpy:
  for t: Ct2987
  Pair(Cpy(Ct2987, t), Cpy(Ct2987, t))

law Ct2987.cpy.leaf:
  for -v: Nat
  for c: Pair(Cpy(Nat, v), Cpy(Nat, v))
  Pair(Cpy(Ct2987, Cl2987{v}), Cpy(Ct2987, Cl2987{v}))

def Ct2987.cpy.leaf(v, c):
  Tuple{Tuple{v1, e1}, Tuple{v2, e2}} = c
  Tuple{Tuple{Cl2987{v1}, cong(Nat, Ct2987, x => Cl2987{x}, v, v1, e1)}, Tuple{Cl2987{v2}, cong(Nat, Ct2987, x => Cl2987{x}, v, v2, e2)}}

law Ct2987.cpy.node:
  for -l: Ct2987
  for -r: Ct2987
  for cl: Pair(Cpy(Ct2987, l), Cpy(Ct2987, l))
  for cr: Pair(Cpy(Ct2987, r), Cpy(Ct2987, r))
  Pair(Cpy(Ct2987, Cn2987{l, r}), Cpy(Ct2987, Cn2987{l, r}))

def Ct2987.cpy.node(l, r, cl, cr):
  Tuple{Tuple{l1, el1}, Tuple{l2, el2}} = cl
  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn2987{l1, r1}, Equal.cong2(Ct2987, Ct2987, Ct2987, x => y => Cn2987{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn2987{l2, r2}, Equal.cong2(Ct2987, Ct2987, Ct2987, x => y => Cn2987{x, y}, l, l2, r, r2, el2, er2)}}

def Ct2987.cpy(t):
  match t:
    case Cl2987{v}:
      Ct2987.cpy.leaf(v, Nat.cpy(v))
    case Cn2987{l, r}:
      Ct2987.cpy.node(l, r, Ct2987.cpy(l), Ct2987.cpy(r))

law cmir2987_mir:
  for t: Ct2987
  {cmir2987(cmir2987(t)) == t : Ct2987}

def cmir2987_mir(t):
  match t:
    case Cl2987{v}:
      {==}
    case Cn2987{l, r}:
      %cmir2987_mir(l) : {Cn2987{cmir2987(cmir2987(l)), cmir2987(cmir2987(r))} == Cn2987{_, r} : Ct2987}
      %cmir2987_mir(r) : {Cn2987{cmir2987(cmir2987(l)), cmir2987(cmir2987(r))} == Cn2987{cmir2987(cmir2987(l)), _} : Ct2987}
      {==}

law csize2987_mir:
  for +t: Ct2987
  {csize2987(cmir2987(t)) == csize2987(t) : Nat}

def csize2987_mir(t):
  match t:
    case Cl2987{v}:
      {==}
    case Cn2987{l, r}:
      %csize2987_mir(r) : {add(csize2987(cmir2987(r)), csize2987(cmir2987(l))) == add(csize2987(l), _) : Nat}
      %csize2987_mir(l) : {add(csize2987(cmir2987(r)), csize2987(cmir2987(l))) == add(_, csize2987(cmir2987(r))) : Nat}
      %add_comm(csize2987(cmir2987(l)), csize2987(cmir2987(r))) : {_ == add(csize2987(cmir2987(l)), csize2987(cmir2987(r))) : Nat}
      {==}

type An2988 is Data:
  Az2988{}
  As2988{pred: An2988}

law aadd2988:
  for a: An2988
  for b: An2988
  An2988

def aadd2988(a, b):
  match a:
    case Az2988{}:
      b
    case As2988{a}:
      As2988{aadd2988(a, b)}

law An2988.cpy:
  for n: An2988
  Pair(Cpy(An2988, n), Cpy(An2988, n))

law An2988.cpy.succ:
  for -p: An2988
  for c: Pair(Cpy(An2988, p), Cpy(An2988, p))
  Pair(Cpy(An2988, As2988{p}), Cpy(An2988, As2988{p}))

def An2988.cpy.succ(p, c):
  Tuple{Tuple{a, ea}, Tuple{b, eb}} = c
  Tuple{Tuple{As2988{a}, cong(An2988, An2988, x => As2988{x}, p, a, ea)}, Tuple{As2988{b}, cong(An2988, An2988, x => As2988{x}, p, b, eb)}}

def An2988.cpy(n):
  match n:
    case Az2988{}:
      Tuple{Tuple{Az2988{}, {==}}, Tuple{Az2988{}, {==}}}
    case As2988{p}:
      An2988.cpy.succ(p, An2988.cpy(p))

law aadd2988_zero:
  for a: An2988
  {aadd2988(a, Az2988{}) == a : An2988}

def aadd2988_zero(a):
  match a:
    case Az2988{}:
      {==}
    case As2988{a}:
      %aadd2988_zero(a) : {As2988{aadd2988(a, Az2988{})} == As2988{_} : An2988}
      {==}

law aadd2988_succ:
  for a: An2988
  for -b: An2988
  {As2988{aadd2988(a, b)} == aadd2988(a, As2988{b}) : An2988}

def aadd2988_succ(a, b):
  match a:
    case Az2988{}:
      {==}
    case As2988{a}:
      %aadd2988_succ(a, b) : {As2988{As2988{aadd2988(a, b)}} == As2988{_} : An2988}
      {==}

law aadd2988_comm:
  for a: An2988
  for +b: An2988
  {aadd2988(a, b) == aadd2988(b, a) : An2988}

def aadd2988_comm(a, b):
  match a:
    case Az2988{}:
      %aadd2988_zero(b) : {_ == aadd2988(b, Az2988{}) : An2988}
      {==}
    case As2988{a}:
      %aadd2988_succ(b, a) : {As2988{aadd2988(a, b)} == _ : An2988}
      %aadd2988_comm(a, b) : {As2988{aadd2988(a, b)} == As2988{_} : An2988}
      {==}

type Bl2989 is Data:
  Bn2989{}
