  Bc61{head: Nat, tail: Bl61}

law bcat61:
  for xs: Bl61
  for ys: Bl61
  Bl61

def bcat61(xs, ys):
  match xs:
    case Bn61{}:
      ys
    case Bc61{h, t}:
      Bc61{h, bcat61(t, ys)}

law blen61:
  for xs: Bl61
  Nat

def blen61(xs):
  match xs:
    case Bn61{}:
      Z{}
    case Bc61{h, t}:
      S{blen61(t)}

law bcat61_nil:
  for xs: Bl61
  {bcat61(xs, Bn61{}) == xs : Bl61}

def bcat61_nil(xs):
  match xs:
    case Bn61{}:
      {==}
    case Bc61{h, t}:
      %bcat61_nil(t) : {Bc61{h, bcat61(t, Bn61{})} == Bc61{h, _} : Bl61}
      {==}

law bcat61_assoc:
  for xs: Bl61
  for -ys: Bl61
  for -zs: Bl61
  {bcat61(bcat61(xs, ys), zs) == bcat61(xs, bcat61(ys, zs)) : Bl61}

def bcat61_assoc(xs, ys, zs):
  match xs:
    case Bn61{}:
      {==}
    case Bc61{h, t}:
      %bcat61_assoc(t, ys, zs) : {Bc61{h, bcat61(bcat61(t, ys), zs)} == Bc61{h, _} : Bl61}
      {==}

law blen61_cat:
  for xs: Bl61
  for -ys: Bl61
  {add(blen61(xs), blen61(ys)) == blen61(bcat61(xs, ys)) : Nat}

def blen61_cat(xs, ys):
  match xs:
    case Bn61{}:
      {==}
    case Bc61{h, t}:
      %blen61_cat(t, ys) : {S{add(blen61(t), blen61(ys))} == S{_} : Nat}
      {==}

type Ct62 is Data:
  Cl62{val: Nat}
  Cn62{lft: Ct62, rgt: Ct62}

law cmir62:
  for t: Ct62
  Ct62

def cmir62(t):
  match t:
    case Cl62{v}:
      Cl62{v}
    case Cn62{l, r}:
      Cn62{cmir62(r), cmir62(l)}

law csize62:
  for t: Ct62
  Nat

def csize62(t):
  match t:
    case Cl62{v}:
      S{Z{}}
    case Cn62{l, r}:
      add(csize62(l), csize62(r))

law Ct62.cpy:
  for t: Ct62
  Pair(Cpy(Ct62, t), Cpy(Ct62, t))

law Ct62.cpy.leaf:
  for -v: Nat
  for c: Pair(Cpy(Nat, v), Cpy(Nat, v))
  Pair(Cpy(Ct62, Cl62{v}), Cpy(Ct62, Cl62{v}))

def Ct62.cpy.leaf(v, c):
  Tuple{Tuple{v1, e1}, Tuple{v2, e2}} = c
  Tuple{Tuple{Cl62{v1}, cong(Nat, Ct62, x => Cl62{x}, v, v1, e1)}, Tuple{Cl62{v2}, cong(Nat, Ct62, x => Cl62{x}, v, v2, e2)}}

law Ct62.cpy.node:
  for -l: Ct62
  for -r: Ct62
  for cl: Pair(Cpy(Ct62, l), Cpy(Ct62, l))
  for cr: Pair(Cpy(Ct62, r), Cpy(Ct62, r))
  Pair(Cpy(Ct62, Cn62{l, r}), Cpy(Ct62, Cn62{l, r}))

def Ct62.cpy.node(l, r, cl, cr):
  Tuple{Tuple{l1, el1}, Tuple{l2, el2}} = cl
  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn62{l1, r1}, Equal.cong2(Ct62, Ct62, Ct62, x => y => Cn62{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn62{l2, r2}, Equal.cong2(Ct62, Ct62, Ct62, x => y => Cn62{x, y}, l, l2, r, r2, el2, er2)}}

def Ct62.cpy(t):
  match t:
    case Cl62{v}:
      Ct62.cpy.leaf(v, Nat.cpy(v))
    case Cn62{l, r}:
      Ct62.cpy.node(l, r, Ct62.cpy(l), Ct62.cpy(r))

law cmir62_mir:
  for t: Ct62
  {cmir62(cmir62(t)) == t : Ct62}

def cmir62_mir(t):
  match t:
    case Cl62{v}:
      {==}
    case Cn62{l, r}:
      %cmir62_mir(l) : {Cn62{cmir62(cmir62(l)), cmir62(cmir62(r))} == Cn62{_, r} : Ct62}
      %cmir62_mir(r) : {Cn62{cmir62(cmir62(l)), cmir62(cmir62(r))} == Cn62{cmir62(cmir62(l)), _} : Ct62}
      {==}

law csize62_mir:
  for +t: Ct62
  {csize62(cmir62(t)) == csize62(t) : Nat}

def csize62_mir(t):
  match t:
    case Cl62{v}:
      {==}
    case Cn62{l, r}:
      %csize62_mir(r) : {add(csize62(cmir62(r)), csize62(cmir62(l))) == add(csize62(l), _) : Nat}
      %csize62_mir(l) : {add(csize62(cmir62(r)), csize62(cmir62(l))) == add(_, csize62(cmir62(r))) : Nat}
      %add_comm(csize62(cmir62(l)), csize62(cmir62(r))) : {_ == add(csize62(cmir62(l)), csize62(cmir62(r))) : Nat}
      {==}

type An63 is Data:
  Az63{}
  As63{pred: An63}

law aadd63:
  for a: An63
  for b: An63
  An63

def aadd63(a, b):
  match a:
    case Az63{}:
      b
    case As63{a}:
      As63{aadd63(a, b)}

law An63.cpy:
  for n: An63
  Pair(Cpy(An63, n), Cpy(An63, n))

law An63.cpy.succ:
  for -p: An63
  for c: Pair(Cpy(An63, p), Cpy(An63, p))
  Pair(Cpy(An63, As63{p}), Cpy(An63, As63{p}))

def An63.cpy.succ(p, c):
  Tuple{Tuple{a, ea}, Tuple{b, eb}} = c
  Tuple{Tuple{As63{a}, cong(An63, An63, x => As63{x}, p, a, ea)}, Tuple{As63{b}, cong(An63, An63, x => As63{x}, p, b, eb)}}

def An63.cpy(n):
  match n:
    case Az63{}:
      Tuple{Tuple{Az63{}, {==}}, Tuple{Az63{}, {==}}}
    case As63{p}:
      An63.cpy.succ(p, An63.cpy(p))

law aadd63_zero:
  for a: An63
  {aadd63(a, Az63{}) == a : An63}

def aadd63_zero(a):
  match a:
    case Az63{}:
      {==}
    case As63{a}:
      %aadd63_zero(a) : {As63{aadd63(a, Az63{})} == As63{_} : An63}
      {==}

law aadd63_succ:
  for a: An63
  for -b: An63
  {As63{aadd63(a, b)} == aadd63(a, As63{b}) : An63}

def aadd63_succ(a, b):
  match a:
    case Az63{}:
      {==}
    case As63{a}:
      %aadd63_succ(a, b) : {As63{As63{aadd63(a, b)}} == As63{_} : An63}
      {==}

law aadd63_comm:
  for a: An63
  for +b: An63
  {aadd63(a, b) == aadd63(b, a) : An63}

def aadd63_comm(a, b):
  match a:
    case Az63{}:
      %aadd63_zero(b) : {_ == aadd63(b, Az63{}) : An63}
      {==}
    case As63{a}:
      %aadd63_succ(b, a) : {As63{aadd63(a, b)} == _ : An63}
      %aadd63_comm(a, b) : {As63{aadd63(a, b)} == As63{_} : An63}
      {==}

