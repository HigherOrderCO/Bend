    case Az2148{}:
      b
    case As2148{a}:
      As2148{aadd2148(a, b)}

law An2148.cpy:
  for n: An2148
  Pair(Cpy(An2148, n), Cpy(An2148, n))

law An2148.cpy.succ:
  for -p: An2148
  for c: Pair(Cpy(An2148, p), Cpy(An2148, p))
  Pair(Cpy(An2148, As2148{p}), Cpy(An2148, As2148{p}))

def An2148.cpy.succ(p, c):
  Tuple{Tuple{a, ea}, Tuple{b, eb}} = c
  Tuple{Tuple{As2148{a}, cong(An2148, An2148, x => As2148{x}, p, a, ea)}, Tuple{As2148{b}, cong(An2148, An2148, x => As2148{x}, p, b, eb)}}

def An2148.cpy(n):
  match n:
