  for t: Ct2891
  {cmir2891(cmir2891(t)) == t : Ct2891}

def cmir2891_mir(t):
  match t:
    case Cl2891{v}:
      {==}
    case Cn2891{l, r}:
      %cmir2891_mir(l) : {Cn2891{cmir2891(cmir2891(l)), cmir2891(cmir2891(r))} == Cn2891{_, r} : Ct2891}
      %cmir2891_mir(r) : {Cn2891{cmir2891(cmir2891(l)), cmir2891(cmir2891(r))} == Cn2891{cmir2891(cmir2891(l)), _} : Ct2891}
