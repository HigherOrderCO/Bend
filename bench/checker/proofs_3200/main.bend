    case Az2640{}:
      b
    case As2640{a}:
      As2640{aadd2640(a, b)}

law An2640.cpy:
  for n: An2640
  Pair(Cpy(An2640, n), Cpy(An2640, n))

law An2640.cpy.succ:
  for -p: An2640
  for c: Pair(Cpy(An2640, p), Cpy(An2640, p))
  Pair(Cpy(An2640, As2640{p}), Cpy(An2640, As2640{p}))

def An2640.cpy.succ(p, c):
  Tuple{Tuple{a, ea}, Tuple{b, eb}} = c
  Tuple{Tuple{As2640{a}, cong(An2640, An2640, x => As2640{x}, p, a, ea)}, Tuple{As2640{b}, cong(An2640, An2640, x => As2640{x}, p, b, eb)}}

def An2640.cpy(n):
  match n:
    case Az2640{}:
      Tuple{Tuple{Az2640{}, {==}}, Tuple{Az2640{}, {==}}}
    case As2640{p}:
      An2640.cpy.succ(p, An2640.cpy(p))

law aadd2640_zero:
  for a: An2640
  {aadd2640(a, Az2640{}) == a : An2640}

def aadd2640_zero(a):
  match a:
    case Az2640{}:
      {==}
    case As2640{a}:
      %aadd2640_zero(a) : {As2640{aadd2640(a, Az2640{})} == As2640{_} : An2640}
      {==}

law aadd2640_succ:
  for a: An2640
  for -b: An2640
  {As2640{aadd2640(a, b)} == aadd2640(a, As2640{b}) : An2640}

def aadd2640_succ(a, b):
  match a:
    case Az2640{}:
      {==}
    case As2640{a}:
      %aadd2640_succ(a, b) : {As2640{As2640{aadd2640(a, b)}} == As2640{_} : An2640}
      {==}

law aadd2640_comm:
  for a: An2640
  for +b: An2640
  {aadd2640(a, b) == aadd2640(b, a) : An2640}

def aadd2640_comm(a, b):
  match a:
    case Az2640{}:
      %aadd2640_zero(b) : {_ == aadd2640(b, Az2640{}) : An2640}
      {==}
    case As2640{a}:
      %aadd2640_succ(b, a) : {As2640{aadd2640(a, b)} == _ : An2640}
      %aadd2640_comm(a, b) : {As2640{aadd2640(a, b)} == As2640{_} : An2640}
      {==}

