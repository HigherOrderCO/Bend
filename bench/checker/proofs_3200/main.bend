law Ct2891.cpy:
  for t: Ct2891
  Pair(Cpy(Ct2891, t), Cpy(Ct2891, t))

law Ct2891.cpy.leaf:
  for -v: Nat
  for c: Pair(Cpy(Nat, v), Cpy(Nat, v))
  Pair(Cpy(Ct2891, Cl2891{v}), Cpy(Ct2891, Cl2891{v}))

def Ct2891.cpy.leaf(v, c):
  Tuple{Tuple{v1, e1}, Tuple{v2, e2}} = c
  Tuple{Tuple{Cl2891{v1}, cong(Nat, Ct2891, x => Cl2891{x}, v, v1, e1)}, Tuple{Cl2891{v2}, cong(Nat, Ct2891, x => Cl2891{x}, v, v2, e2)}}

law Ct2891.cpy.node:
  for -l: Ct2891
  for -r: Ct2891
  for cl: Pair(Cpy(Ct2891, l), Cpy(Ct2891, l))
  for cr: Pair(Cpy(Ct2891, r), Cpy(Ct2891, r))
  Pair(Cpy(Ct2891, Cn2891{l, r}), Cpy(Ct2891, Cn2891{l, r}))

