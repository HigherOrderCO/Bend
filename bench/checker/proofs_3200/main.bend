  Cn2858{lft: Ct2858, rgt: Ct2858}

law cmir2858:
  for t: Ct2858
  Ct2858

def cmir2858(t):
  match t:
    case Cl2858{v}:
      Cl2858{v}
    case Cn2858{l, r}:
      Cn2858{cmir2858(r), cmir2858(l)}

law csize2858:
  for t: Ct2858
  Nat

def csize2858(t):
  match t:
    case Cl2858{v}:
      S{Z{}}
    case Cn2858{l, r}:
      add(csize2858(l), csize2858(r))

law Ct2858.cpy:
  for t: Ct2858
  Pair(Cpy(Ct2858, t), Cpy(Ct2858, t))

law Ct2858.cpy.leaf:
  for -v: Nat
  for c: Pair(Cpy(Nat, v), Cpy(Nat, v))
  Pair(Cpy(Ct2858, Cl2858{v}), Cpy(Ct2858, Cl2858{v}))

def Ct2858.cpy.leaf(v, c):
  Tuple{Tuple{v1, e1}, Tuple{v2, e2}} = c
  Tuple{Tuple{Cl2858{v1}, cong(Nat, Ct2858, x => Cl2858{x}, v, v1, e1)}, Tuple{Cl2858{v2}, cong(Nat, Ct2858, x => Cl2858{x}, v, v2, e2)}}

law Ct2858.cpy.node:
  for -l: Ct2858
  for -r: Ct2858
  for cl: Pair(Cpy(Ct2858, l), Cpy(Ct2858, l))
  for cr: Pair(Cpy(Ct2858, r), Cpy(Ct2858, r))
  Pair(Cpy(Ct2858, Cn2858{l, r}), Cpy(Ct2858, Cn2858{l, r}))

def Ct2858.cpy.node(l, r, cl, cr):
  Tuple{Tuple{l1, el1}, Tuple{l2, el2}} = cl
  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn2858{l1, r1}, Equal.cong2(Ct2858, Ct2858, Ct2858, x => y => Cn2858{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn2858{l2, r2}, Equal.cong2(Ct2858, Ct2858, Ct2858, x => y => Cn2858{x, y}, l, l2, r, r2, el2, er2)}}

def Ct2858.cpy(t):
  match t:
    case Cl2858{v}:
      Ct2858.cpy.leaf(v, Nat.cpy(v))
    case Cn2858{l, r}:
      Ct2858.cpy.node(l, r, Ct2858.cpy(l), Ct2858.cpy(r))

law cmir2858_mir:
  for t: Ct2858
  {cmir2858(cmir2858(t)) == t : Ct2858}

def cmir2858_mir(t):
  match t:
    case Cl2858{v}:
      {==}
    case Cn2858{l, r}:
      %cmir2858_mir(l) : {Cn2858{cmir2858(cmir2858(l)), cmir2858(cmir2858(r))} == Cn2858{_, r} : Ct2858}
      %cmir2858_mir(r) : {Cn2858{cmir2858(cmir2858(l)), cmir2858(cmir2858(r))} == Cn2858{cmir2858(cmir2858(l)), _} : Ct2858}
      {==}

law csize2858_mir:
  for +t: Ct2858
  {csize2858(cmir2858(t)) == csize2858(t) : Nat}

def csize2858_mir(t):
  match t:
    case Cl2858{v}:
      {==}
    case Cn2858{l, r}:
      %csize2858_mir(r) : {add(csize2858(cmir2858(r)), csize2858(cmir2858(l))) == add(csize2858(l), _) : Nat}
      %csize2858_mir(l) : {add(csize2858(cmir2858(r)), csize2858(cmir2858(l))) == add(_, csize2858(cmir2858(r))) : Nat}
      %add_comm(csize2858(cmir2858(l)), csize2858(cmir2858(r))) : {_ == add(csize2858(cmir2858(l)), csize2858(cmir2858(r))) : Nat}
      {==}

type An2859 is Data:
  Az2859{}
  As2859{pred: An2859}

law aadd2859:
  for a: An2859
  for b: An2859
  An2859

def aadd2859(a, b):
  match a:
    case Az2859{}:
      b
    case As2859{a}:
      As2859{aadd2859(a, b)}

law An2859.cpy:
  for n: An2859
  Pair(Cpy(An2859, n), Cpy(An2859, n))

law An2859.cpy.succ:
  for -p: An2859
  for c: Pair(Cpy(An2859, p), Cpy(An2859, p))
  Pair(Cpy(An2859, As2859{p}), Cpy(An2859, As2859{p}))

def An2859.cpy.succ(p, c):
  Tuple{Tuple{a, ea}, Tuple{b, eb}} = c
  Tuple{Tuple{As2859{a}, cong(An2859, An2859, x => As2859{x}, p, a, ea)}, Tuple{As2859{b}, cong(An2859, An2859, x => As2859{x}, p, b, eb)}}

def An2859.cpy(n):
  match n:
    case Az2859{}:
      Tuple{Tuple{Az2859{}, {==}}, Tuple{Az2859{}, {==}}}
    case As2859{p}:
      An2859.cpy.succ(p, An2859.cpy(p))

law aadd2859_zero:
  for a: An2859
  {aadd2859(a, Az2859{}) == a : An2859}

def aadd2859_zero(a):
  match a:
    case Az2859{}:
      {==}
    case As2859{a}:
      %aadd2859_zero(a) : {As2859{aadd2859(a, Az2859{})} == As2859{_} : An2859}
      {==}

law aadd2859_succ:
  for a: An2859
  for -b: An2859
  {As2859{aadd2859(a, b)} == aadd2859(a, As2859{b}) : An2859}

def aadd2859_succ(a, b):
  match a:
    case Az2859{}:
      {==}
    case As2859{a}:
      %aadd2859_succ(a, b) : {As2859{As2859{aadd2859(a, b)}} == As2859{_} : An2859}
      {==}

law aadd2859_comm:
  for a: An2859
  for +b: An2859
  {aadd2859(a, b) == aadd2859(b, a) : An2859}

def aadd2859_comm(a, b):
  match a:
    case Az2859{}:
      %aadd2859_zero(b) : {_ == aadd2859(b, Az2859{}) : An2859}
      {==}
    case As2859{a}:
      %aadd2859_succ(b, a) : {As2859{aadd2859(a, b)} == _ : An2859}
      %aadd2859_comm(a, b) : {As2859{aadd2859(a, b)} == As2859{_} : An2859}
      {==}

