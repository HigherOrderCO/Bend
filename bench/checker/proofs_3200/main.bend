  Cn1736{lft: Ct1736, rgt: Ct1736}

law cmir1736:
  for t: Ct1736
  Ct1736

def cmir1736(t):
  match t:
    case Cl1736{v}:
      Cl1736{v}
    case Cn1736{l, r}:
      Cn1736{cmir1736(r), cmir1736(l)}

law csize1736:
  for t: Ct1736
  Nat

def csize1736(t):
  match t:
    case Cl1736{v}:
      S{Z{}}
    case Cn1736{l, r}:
      add(csize1736(l), csize1736(r))

law Ct1736.cpy:
  for t: Ct1736
  Pair(Cpy(Ct1736, t), Cpy(Ct1736, t))

law Ct1736.cpy.leaf:
  for -v: Nat
  for c: Pair(Cpy(Nat, v), Cpy(Nat, v))
  Pair(Cpy(Ct1736, Cl1736{v}), Cpy(Ct1736, Cl1736{v}))

def Ct1736.cpy.leaf(v, c):
  Tuple{Tuple{v1, e1}, Tuple{v2, e2}} = c
  Tuple{Tuple{Cl1736{v1}, cong(Nat, Ct1736, x => Cl1736{x}, v, v1, e1)}, Tuple{Cl1736{v2}, cong(Nat, Ct1736, x => Cl1736{x}, v, v2, e2)}}

law Ct1736.cpy.node:
  for -l: Ct1736
  for -r: Ct1736
  for cl: Pair(Cpy(Ct1736, l), Cpy(Ct1736, l))
  for cr: Pair(Cpy(Ct1736, r), Cpy(Ct1736, r))
  Pair(Cpy(Ct1736, Cn1736{l, r}), Cpy(Ct1736, Cn1736{l, r}))

def Ct1736.cpy.node(l, r, cl, cr):
  Tuple{Tuple{l1, el1}, Tuple{l2, el2}} = cl
  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn1736{l1, r1}, Equal.cong2(Ct1736, Ct1736, Ct1736, x => y => Cn1736{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn1736{l2, r2}, Equal.cong2(Ct1736, Ct1736, Ct1736, x => y => Cn1736{x, y}, l, l2, r, r2, el2, er2)}}

def Ct1736.cpy(t):
  match t:
    case Cl1736{v}:
      Ct1736.cpy.leaf(v, Nat.cpy(v))
    case Cn1736{l, r}:
      Ct1736.cpy.node(l, r, Ct1736.cpy(l), Ct1736.cpy(r))

law cmir1736_mir:
  for t: Ct1736
  {cmir1736(cmir1736(t)) == t : Ct1736}

def cmir1736_mir(t):
  match t:
    case Cl1736{v}:
      {==}
    case Cn1736{l, r}:
      %cmir1736_mir(l) : {Cn1736{cmir1736(cmir1736(l)), cmir1736(cmir1736(r))} == Cn1736{_, r} : Ct1736}
      %cmir1736_mir(r) : {Cn1736{cmir1736(cmir1736(l)), cmir1736(cmir1736(r))} == Cn1736{cmir1736(cmir1736(l)), _} : Ct1736}
      {==}

law csize1736_mir:
  for +t: Ct1736
  {csize1736(cmir1736(t)) == csize1736(t) : Nat}

def csize1736_mir(t):
  match t:
    case Cl1736{v}:
      {==}
    case Cn1736{l, r}:
      %csize1736_mir(r) : {add(csize1736(cmir1736(r)), csize1736(cmir1736(l))) == add(csize1736(l), _) : Nat}
      %csize1736_mir(l) : {add(csize1736(cmir1736(r)), csize1736(cmir1736(l))) == add(_, csize1736(cmir1736(r))) : Nat}
      %add_comm(csize1736(cmir1736(l)), csize1736(cmir1736(r))) : {_ == add(csize1736(cmir1736(l)), csize1736(cmir1736(r))) : Nat}
      {==}

type An1737 is Data:
  Az1737{}
  As1737{pred: An1737}

law aadd1737:
  for a: An1737
  for b: An1737
  An1737

def aadd1737(a, b):
  match a:
    case Az1737{}:
      b
    case As1737{a}:
      As1737{aadd1737(a, b)}

law An1737.cpy:
  for n: An1737
  Pair(Cpy(An1737, n), Cpy(An1737, n))

law An1737.cpy.succ:
  for -p: An1737
  for c: Pair(Cpy(An1737, p), Cpy(An1737, p))
  Pair(Cpy(An1737, As1737{p}), Cpy(An1737, As1737{p}))

def An1737.cpy.succ(p, c):
  Tuple{Tuple{a, ea}, Tuple{b, eb}} = c
  Tuple{Tuple{As1737{a}, cong(An1737, An1737, x => As1737{x}, p, a, ea)}, Tuple{As1737{b}, cong(An1737, An1737, x => As1737{x}, p, b, eb)}}

def An1737.cpy(n):
  match n:
    case Az1737{}:
      Tuple{Tuple{Az1737{}, {==}}, Tuple{Az1737{}, {==}}}
    case As1737{p}:
      An1737.cpy.succ(p, An1737.cpy(p))

law aadd1737_zero:
  for a: An1737
  {aadd1737(a, Az1737{}) == a : An1737}

def aadd1737_zero(a):
  match a:
    case Az1737{}:
      {==}
    case As1737{a}:
      %aadd1737_zero(a) : {As1737{aadd1737(a, Az1737{})} == As1737{_} : An1737}
      {==}

law aadd1737_succ:
  for a: An1737
  for -b: An1737
  {As1737{aadd1737(a, b)} == aadd1737(a, As1737{b}) : An1737}

def aadd1737_succ(a, b):
  match a:
    case Az1737{}:
      {==}
    case As1737{a}:
      %aadd1737_succ(a, b) : {As1737{As1737{aadd1737(a, b)}} == As1737{_} : An1737}
      {==}

law aadd1737_comm:
  for a: An1737
  for +b: An1737
  {aadd1737(a, b) == aadd1737(b, a) : An1737}

def aadd1737_comm(a, b):
  match a:
    case Az1737{}:
      %aadd1737_zero(b) : {_ == aadd1737(b, Az1737{}) : An1737}
      {==}
    case As1737{a}:
      %aadd1737_succ(b, a) : {As1737{aadd1737(a, b)} == _ : An1737}
      %aadd1737_comm(a, b) : {As1737{aadd1737(a, b)} == As1737{_} : An1737}
      {==}

