  match xs:
    case Bn1639{}:
      {==}
    case Bc1639{h, t}:
      %bcat1639_assoc(t, ys, zs) : {Bc1639{h, bcat1639(bcat1639(t, ys), zs)} == Bc1639{h, _} : Bl1639}
      {==}

