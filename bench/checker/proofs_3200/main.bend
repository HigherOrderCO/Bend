law Ct2633.cpy:
  for t: Ct2633
  Pair(Cpy(Ct2633, t), Cpy(Ct2633, t))

law Ct2633.cpy.leaf:
  for -v: Nat
  for c: Pair(Cpy(Nat, v), Cpy(Nat, v))
  Pair(Cpy(Ct2633, Cl2633{v}), Cpy(Ct2633, Cl2633{v}))

def Ct2633.cpy.leaf(v, c):
  Tuple{Tuple{v1, e1}, Tuple{v2, e2}} = c
  Tuple{Tuple{Cl2633{v1}, cong(Nat, Ct2633, x => Cl2633{x}, v, v1, e1)}, Tuple{Cl2633{v2}, cong(Nat, Ct2633, x => Cl2633{x}, v, v2, e2)}}

