law Ct1931.cpy:
  for t: Ct1931
  Pair(Cpy(Ct1931, t), Cpy(Ct1931, t))

law Ct1931.cpy.leaf:
  for -v: Nat
  for c: Pair(Cpy(Nat, v), Cpy(Nat, v))
  Pair(Cpy(Ct1931, Cl1931{v}), Cpy(Ct1931, Cl1931{v}))

def Ct1931.cpy.leaf(v, c):
  Tuple{Tuple{v1, e1}, Tuple{v2, e2}} = c
  Tuple{Tuple{Cl1931{v1}, cong(Nat, Ct1931, x => Cl1931{x}, v, v1, e1)}, Tuple{Cl1931{v2}, cong(Nat, Ct1931, x => Cl1931{x}, v, v2, e2)}}

law Ct1931.cpy.node:
  for -l: Ct1931
  for -r: Ct1931
  for cl: Pair(Cpy(Ct1931, l), Cpy(Ct1931, l))
  for cr: Pair(Cpy(Ct1931, r), Cpy(Ct1931, r))
  Pair(Cpy(Ct1931, Cn1931{l, r}), Cpy(Ct1931, Cn1931{l, r}))

def Ct1931.cpy.node(l, r, cl, cr):
  Tuple{Tuple{l1, el1}, Tuple{l2, el2}} = cl
  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn1931{l1, r1}, Equal.cong2(Ct1931, Ct1931, Ct1931, x => y => Cn1931{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn1931{l2, r2}, Equal.cong2(Ct1931, Ct1931, Ct1931, x => y => Cn1931{x, y}, l, l2, r, r2, el2, er2)}}

def Ct1931.cpy(t):
  match t:
    case Cl1931{v}:
      Ct1931.cpy.leaf(v, Nat.cpy(v))
    case Cn1931{l, r}:
      Ct1931.cpy.node(l, r, Ct1931.cpy(l), Ct1931.cpy(r))

law cmir1931_mir:
  for t: Ct1931
  {cmir1931(cmir1931(t)) == t : Ct1931}

def cmir1931_mir(t):
  match t:
    case Cl1931{v}:
      {==}
    case Cn1931{l, r}:
      %cmir1931_mir(l) : {Cn1931{cmir1931(cmir1931(l)), cmir1931(cmir1931(r))} == Cn1931{_, r} : Ct1931}
      %cmir1931_mir(r) : {Cn1931{cmir1931(cmir1931(l)), cmir1931(cmir1931(r))} == Cn1931{cmir1931(cmir1931(l)), _} : Ct1931}
      {==}

law csize1931_mir:
  for +t: Ct1931
  {csize1931(cmir1931(t)) == csize1931(t) : Nat}

def csize1931_mir(t):
  match t:
    case Cl1931{v}:
      {==}
    case Cn1931{l, r}:
      %csize1931_mir(r) : {add(csize1931(cmir1931(r)), csize1931(cmir1931(l))) == add(csize1931(l), _) : Nat}
      %csize1931_mir(l) : {add(csize1931(cmir1931(r)), csize1931(cmir1931(l))) == add(_, csize1931(cmir1931(r))) : Nat}
      %add_comm(csize1931(cmir1931(l)), csize1931(cmir1931(r))) : {_ == add(csize1931(cmir1931(l)), csize1931(cmir1931(r))) : Nat}
      {==}

