  Cn1841{lft: Ct1841, rgt: Ct1841}

law cmir1841:
  for t: Ct1841
  Ct1841

def cmir1841(t):
  match t:
    case Cl1841{v}:
      Cl1841{v}
    case Cn1841{l, r}:
      Cn1841{cmir1841(r), cmir1841(l)}

law csize1841:
  for t: Ct1841
  Nat

def csize1841(t):
  match t:
    case Cl1841{v}:
      S{Z{}}
    case Cn1841{l, r}:
      add(csize1841(l), csize1841(r))

law Ct1841.cpy:
  for t: Ct1841
  Pair(Cpy(Ct1841, t), Cpy(Ct1841, t))

law Ct1841.cpy.leaf:
  for -v: Nat
  for c: Pair(Cpy(Nat, v), Cpy(Nat, v))
  Pair(Cpy(Ct1841, Cl1841{v}), Cpy(Ct1841, Cl1841{v}))

def Ct1841.cpy.leaf(v, c):
  Tuple{Tuple{v1, e1}, Tuple{v2, e2}} = c
  Tuple{Tuple{Cl1841{v1}, cong(Nat, Ct1841, x => Cl1841{x}, v, v1, e1)}, Tuple{Cl1841{v2}, cong(Nat, Ct1841, x => Cl1841{x}, v, v2, e2)}}

law Ct1841.cpy.node:
  for -l: Ct1841
  for -r: Ct1841
  for cl: Pair(Cpy(Ct1841, l), Cpy(Ct1841, l))
  for cr: Pair(Cpy(Ct1841, r), Cpy(Ct1841, r))
  Pair(Cpy(Ct1841, Cn1841{l, r}), Cpy(Ct1841, Cn1841{l, r}))

def Ct1841.cpy.node(l, r, cl, cr):
  Tuple{Tuple{l1, el1}, Tuple{l2, el2}} = cl
  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn1841{l1, r1}, Equal.cong2(Ct1841, Ct1841, Ct1841, x => y => Cn1841{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn1841{l2, r2}, Equal.cong2(Ct1841, Ct1841, Ct1841, x => y => Cn1841{x, y}, l, l2, r, r2, el2, er2)}}

def Ct1841.cpy(t):
  match t:
    case Cl1841{v}:
      Ct1841.cpy.leaf(v, Nat.cpy(v))
    case Cn1841{l, r}:
      Ct1841.cpy.node(l, r, Ct1841.cpy(l), Ct1841.cpy(r))

law cmir1841_mir:
  for t: Ct1841
  {cmir1841(cmir1841(t)) == t : Ct1841}

def cmir1841_mir(t):
  match t:
    case Cl1841{v}:
      {==}
    case Cn1841{l, r}:
      %cmir1841_mir(l) : {Cn1841{cmir1841(cmir1841(l)), cmir1841(cmir1841(r))} == Cn1841{_, r} : Ct1841}
      %cmir1841_mir(r) : {Cn1841{cmir1841(cmir1841(l)), cmir1841(cmir1841(r))} == Cn1841{cmir1841(cmir1841(l)), _} : Ct1841}
      {==}

law csize1841_mir:
  for +t: Ct1841
  {csize1841(cmir1841(t)) == csize1841(t) : Nat}

def csize1841_mir(t):
  match t:
    case Cl1841{v}:
      {==}
    case Cn1841{l, r}:
      %csize1841_mir(r) : {add(csize1841(cmir1841(r)), csize1841(cmir1841(l))) == add(csize1841(l), _) : Nat}
      %csize1841_mir(l) : {add(csize1841(cmir1841(r)), csize1841(cmir1841(l))) == add(_, csize1841(cmir1841(r))) : Nat}
      %add_comm(csize1841(cmir1841(l)), csize1841(cmir1841(r))) : {_ == add(csize1841(cmir1841(l)), csize1841(cmir1841(r))) : Nat}
      {==}

type An1842 is Data:
  Az1842{}
  As1842{pred: An1842}

law aadd1842:
  for a: An1842
  for b: An1842
  An1842

def aadd1842(a, b):
  match a:
    case Az1842{}:
      b
    case As1842{a}:
      As1842{aadd1842(a, b)}

law An1842.cpy:
  for n: An1842
  Pair(Cpy(An1842, n), Cpy(An1842, n))

law An1842.cpy.succ:
  for -p: An1842
  for c: Pair(Cpy(An1842, p), Cpy(An1842, p))
  Pair(Cpy(An1842, As1842{p}), Cpy(An1842, As1842{p}))

def An1842.cpy.succ(p, c):
  Tuple{Tuple{a, ea}, Tuple{b, eb}} = c
  Tuple{Tuple{As1842{a}, cong(An1842, An1842, x => As1842{x}, p, a, ea)}, Tuple{As1842{b}, cong(An1842, An1842, x => As1842{x}, p, b, eb)}}

def An1842.cpy(n):
  match n:
    case Az1842{}:
      Tuple{Tuple{Az1842{}, {==}}, Tuple{Az1842{}, {==}}}
    case As1842{p}:
      An1842.cpy.succ(p, An1842.cpy(p))

law aadd1842_zero:
  for a: An1842
  {aadd1842(a, Az1842{}) == a : An1842}

def aadd1842_zero(a):
  match a:
    case Az1842{}:
      {==}
    case As1842{a}:
      %aadd1842_zero(a) : {As1842{aadd1842(a, Az1842{})} == As1842{_} : An1842}
      {==}

law aadd1842_succ:
  for a: An1842
  for -b: An1842
  {As1842{aadd1842(a, b)} == aadd1842(a, As1842{b}) : An1842}

def aadd1842_succ(a, b):
  match a:
    case Az1842{}:
      {==}
    case As1842{a}:
      %aadd1842_succ(a, b) : {As1842{As1842{aadd1842(a, b)}} == As1842{_} : An1842}
      {==}

law aadd1842_comm:
  for a: An1842
  for +b: An1842
  {aadd1842(a, b) == aadd1842(b, a) : An1842}

def aadd1842_comm(a, b):
  match a:
    case Az1842{}:
      %aadd1842_zero(b) : {_ == aadd1842(b, Az1842{}) : An1842}
      {==}
    case As1842{a}:
      %aadd1842_succ(b, a) : {As1842{aadd1842(a, b)} == _ : An1842}
      %aadd1842_comm(a, b) : {As1842{aadd1842(a, b)} == As1842{_} : An1842}
      {==}

type Bl1843 is Data:
  Bn1843{}
  Bc1843{head: Nat, tail: Bl1843}

law bcat1843:
  for xs: Bl1843
  for ys: Bl1843
  Bl1843

def bcat1843(xs, ys):
  match xs:
    case Bn1843{}:
      ys
    case Bc1843{h, t}:
      Bc1843{h, bcat1843(t, ys)}

law blen1843:
  for xs: Bl1843
  Nat

def blen1843(xs):
  match xs:
    case Bn1843{}:
      Z{}
    case Bc1843{h, t}:
      S{blen1843(t)}

law bcat1843_nil:
  for xs: Bl1843
  {bcat1843(xs, Bn1843{}) == xs : Bl1843}

def bcat1843_nil(xs):
  match xs:
    case Bn1843{}:
      {==}
    case Bc1843{h, t}:
      %bcat1843_nil(t) : {Bc1843{h, bcat1843(t, Bn1843{})} == Bc1843{h, _} : Bl1843}
      {==}

law bcat1843_assoc:
  for xs: Bl1843
  for -ys: Bl1843
  for -zs: Bl1843
  {bcat1843(bcat1843(xs, ys), zs) == bcat1843(xs, bcat1843(ys, zs)) : Bl1843}

def bcat1843_assoc(xs, ys, zs):
  match xs:
    case Bn1843{}:
      {==}
    case Bc1843{h, t}:
      %bcat1843_assoc(t, ys, zs) : {Bc1843{h, bcat1843(bcat1843(t, ys), zs)} == Bc1843{h, _} : Bl1843}
      {==}

law blen1843_cat:
  for xs: Bl1843
  for -ys: Bl1843
  {add(blen1843(xs), blen1843(ys)) == blen1843(bcat1843(xs, ys)) : Nat}

def blen1843_cat(xs, ys):
  match xs:
    case Bn1843{}:
      {==}
    case Bc1843{h, t}:
      %blen1843_cat(t, ys) : {S{add(blen1843(t), blen1843(ys))} == S{_} : Nat}
      {==}

