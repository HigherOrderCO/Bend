  Cn2342{lft: Ct2342, rgt: Ct2342}

law cmir2342:
  for t: Ct2342
  Ct2342

def cmir2342(t):
  match t:
    case Cl2342{v}:
      Cl2342{v}
    case Cn2342{l, r}:
      Cn2342{cmir2342(r), cmir2342(l)}

law csize2342:
  for t: Ct2342
  Nat

def csize2342(t):
  match t:
    case Cl2342{v}:
      S{Z{}}
    case Cn2342{l, r}:
      add(csize2342(l), csize2342(r))

law Ct2342.cpy:
  for t: Ct2342
  Pair(Cpy(Ct2342, t), Cpy(Ct2342, t))

law Ct2342.cpy.leaf:
  for -v: Nat
  for c: Pair(Cpy(Nat, v), Cpy(Nat, v))
  Pair(Cpy(Ct2342, Cl2342{v}), Cpy(Ct2342, Cl2342{v}))

def Ct2342.cpy.leaf(v, c):
  Tuple{Tuple{v1, e1}, Tuple{v2, e2}} = c
  Tuple{Tuple{Cl2342{v1}, cong(Nat, Ct2342, x => Cl2342{x}, v, v1, e1)}, Tuple{Cl2342{v2}, cong(Nat, Ct2342, x => Cl2342{x}, v, v2, e2)}}

law Ct2342.cpy.node:
  for -l: Ct2342
  for -r: Ct2342
  for cl: Pair(Cpy(Ct2342, l), Cpy(Ct2342, l))
  for cr: Pair(Cpy(Ct2342, r), Cpy(Ct2342, r))
  Pair(Cpy(Ct2342, Cn2342{l, r}), Cpy(Ct2342, Cn2342{l, r}))

def Ct2342.cpy.node(l, r, cl, cr):
  Tuple{Tuple{l1, el1}, Tuple{l2, el2}} = cl
  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn2342{l1, r1}, Equal.cong2(Ct2342, Ct2342, Ct2342, x => y => Cn2342{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn2342{l2, r2}, Equal.cong2(Ct2342, Ct2342, Ct2342, x => y => Cn2342{x, y}, l, l2, r, r2, el2, er2)}}

def Ct2342.cpy(t):
  match t:
    case Cl2342{v}:
      Ct2342.cpy.leaf(v, Nat.cpy(v))
    case Cn2342{l, r}:
      Ct2342.cpy.node(l, r, Ct2342.cpy(l), Ct2342.cpy(r))

law cmir2342_mir:
  for t: Ct2342
  {cmir2342(cmir2342(t)) == t : Ct2342}

def cmir2342_mir(t):
  match t:
    case Cl2342{v}:
      {==}
    case Cn2342{l, r}:
      %cmir2342_mir(l) : {Cn2342{cmir2342(cmir2342(l)), cmir2342(cmir2342(r))} == Cn2342{_, r} : Ct2342}
      %cmir2342_mir(r) : {Cn2342{cmir2342(cmir2342(l)), cmir2342(cmir2342(r))} == Cn2342{cmir2342(cmir2342(l)), _} : Ct2342}
      {==}

law csize2342_mir:
  for +t: Ct2342
  {csize2342(cmir2342(t)) == csize2342(t) : Nat}

def csize2342_mir(t):
  match t:
    case Cl2342{v}:
      {==}
    case Cn2342{l, r}:
      %csize2342_mir(r) : {add(csize2342(cmir2342(r)), csize2342(cmir2342(l))) == add(csize2342(l), _) : Nat}
      %csize2342_mir(l) : {add(csize2342(cmir2342(r)), csize2342(cmir2342(l))) == add(_, csize2342(cmir2342(r))) : Nat}
      %add_comm(csize2342(cmir2342(l)), csize2342(cmir2342(r))) : {_ == add(csize2342(cmir2342(l)), csize2342(cmir2342(r))) : Nat}
      {==}

type An2343 is Data:
  Az2343{}
  As2343{pred: An2343}

law aadd2343:
  for a: An2343
  for b: An2343
  An2343

def aadd2343(a, b):
  match a:
    case Az2343{}:
      b
    case As2343{a}:
      As2343{aadd2343(a, b)}

law An2343.cpy:
  for n: An2343
  Pair(Cpy(An2343, n), Cpy(An2343, n))

law An2343.cpy.succ:
  for -p: An2343
  for c: Pair(Cpy(An2343, p), Cpy(An2343, p))
  Pair(Cpy(An2343, As2343{p}), Cpy(An2343, As2343{p}))

def An2343.cpy.succ(p, c):
  Tuple{Tuple{a, ea}, Tuple{b, eb}} = c
  Tuple{Tuple{As2343{a}, cong(An2343, An2343, x => As2343{x}, p, a, ea)}, Tuple{As2343{b}, cong(An2343, An2343, x => As2343{x}, p, b, eb)}}

def An2343.cpy(n):
  match n:
    case Az2343{}:
      Tuple{Tuple{Az2343{}, {==}}, Tuple{Az2343{}, {==}}}
    case As2343{p}:
      An2343.cpy.succ(p, An2343.cpy(p))

law aadd2343_zero:
  for a: An2343
  {aadd2343(a, Az2343{}) == a : An2343}

def aadd2343_zero(a):
  match a:
    case Az2343{}:
      {==}
    case As2343{a}:
      %aadd2343_zero(a) : {As2343{aadd2343(a, Az2343{})} == As2343{_} : An2343}
      {==}

law aadd2343_succ:
  for a: An2343
  for -b: An2343
  {As2343{aadd2343(a, b)} == aadd2343(a, As2343{b}) : An2343}

def aadd2343_succ(a, b):
  match a:
    case Az2343{}:
      {==}
    case As2343{a}:
      %aadd2343_succ(a, b) : {As2343{As2343{aadd2343(a, b)}} == As2343{_} : An2343}
      {==}

law aadd2343_comm:
  for a: An2343
  for +b: An2343
  {aadd2343(a, b) == aadd2343(b, a) : An2343}

def aadd2343_comm(a, b):
  match a:
    case Az2343{}:
      %aadd2343_zero(b) : {_ == aadd2343(b, Az2343{}) : An2343}
      {==}
    case As2343{a}:
      %aadd2343_succ(b, a) : {As2343{aadd2343(a, b)} == _ : An2343}
      %aadd2343_comm(a, b) : {As2343{aadd2343(a, b)} == As2343{_} : An2343}
      {==}

type Bl2344 is Data:
  Bn2344{}
  Bc2344{head: Nat, tail: Bl2344}

law bcat2344:
  for xs: Bl2344
  for ys: Bl2344
  Bl2344

def bcat2344(xs, ys):
  match xs:
    case Bn2344{}:
      ys
    case Bc2344{h, t}:
      Bc2344{h, bcat2344(t, ys)}

law blen2344:
  for xs: Bl2344
  Nat

def blen2344(xs):
  match xs:
    case Bn2344{}:
      Z{}
    case Bc2344{h, t}:
      S{blen2344(t)}

law bcat2344_nil:
  for xs: Bl2344
  {bcat2344(xs, Bn2344{}) == xs : Bl2344}

def bcat2344_nil(xs):
  match xs:
    case Bn2344{}:
      {==}
    case Bc2344{h, t}:
      %bcat2344_nil(t) : {Bc2344{h, bcat2344(t, Bn2344{})} == Bc2344{h, _} : Bl2344}
      {==}

law bcat2344_assoc:
  for xs: Bl2344
  for -ys: Bl2344
  for -zs: Bl2344
  {bcat2344(bcat2344(xs, ys), zs) == bcat2344(xs, bcat2344(ys, zs)) : Bl2344}

def bcat2344_assoc(xs, ys, zs):
  match xs:
    case Bn2344{}:
      {==}
    case Bc2344{h, t}:
      %bcat2344_assoc(t, ys, zs) : {Bc2344{h, bcat2344(bcat2344(t, ys), zs)} == Bc2344{h, _} : Bl2344}
      {==}

law blen2344_cat:
  for xs: Bl2344
  for -ys: Bl2344
  {add(blen2344(xs), blen2344(ys)) == blen2344(bcat2344(xs, ys)) : Nat}

def blen2344_cat(xs, ys):
  match xs:
    case Bn2344{}:
      {==}
    case Bc2344{h, t}:
      %blen2344_cat(t, ys) : {S{add(blen2344(t), blen2344(ys))} == S{_} : Nat}
      {==}

