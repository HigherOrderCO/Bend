      {==}
    case Cn2642{l, r}:
      %cmir2642_mir(l) : {Cn2642{cmir2642(cmir2642(l)), cmir2642(cmir2642(r))} == Cn2642{_, r} : Ct2642}
      %cmir2642_mir(r) : {Cn2642{cmir2642(cmir2642(l)), cmir2642(cmir2642(r))} == Cn2642{cmir2642(cmir2642(l)), _} : Ct2642}
