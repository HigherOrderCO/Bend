type Ct3197 is Data:
  Cl3197{val: Nat}
  Cn3197{lft: Ct3197, rgt: Ct3197}

law cmir3197:
  for t: Ct3197
  Ct3197

def cmir3197(t):
  match t:
    case Cl3197{v}:
      Cl3197{v}
    case Cn3197{l, r}:
      Cn3197{cmir3197(r), cmir3197(l)}

law csize3197:
  for t: Ct3197
  Nat

def csize3197(t):
  match t:
    case Cl3197{v}:
      S{Z{}}
    case Cn3197{l, r}:
      add(csize3197(l), csize3197(r))

law Ct3197.cpy:
  for t: Ct3197
  Pair(Cpy(Ct3197, t), Cpy(Ct3197, t))

law Ct3197.cpy.leaf:
  for -v: Nat
  for c: Pair(Cpy(Nat, v), Cpy(Nat, v))
  Pair(Cpy(Ct3197, Cl3197{v}), Cpy(Ct3197, Cl3197{v}))

def Ct3197.cpy.leaf(v, c):
  Tuple{Tuple{v1, e1}, Tuple{v2, e2}} = c
  Tuple{Tuple{Cl3197{v1}, cong(Nat, Ct3197, x => Cl3197{x}, v, v1, e1)}, Tuple{Cl3197{v2}, cong(Nat, Ct3197, x => Cl3197{x}, v, v2, e2)}}

law Ct3197.cpy.node:
  for -l: Ct3197
  for -r: Ct3197
  for cl: Pair(Cpy(Ct3197, l), Cpy(Ct3197, l))
  for cr: Pair(Cpy(Ct3197, r), Cpy(Ct3197, r))
  Pair(Cpy(Ct3197, Cn3197{l, r}), Cpy(Ct3197, Cn3197{l, r}))

def Ct3197.cpy.node(l, r, cl, cr):
  Tuple{Tuple{l1, el1}, Tuple{l2, el2}} = cl
  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn3197{l1, r1}, Equal.cong2(Ct3197, Ct3197, Ct3197, x => y => Cn3197{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn3197{l2, r2}, Equal.cong2(Ct3197, Ct3197, Ct3197, x => y => Cn3197{x, y}, l, l2, r, r2, el2, er2)}}

def Ct3197.cpy(t):
  match t:
    case Cl3197{v}:
      Ct3197.cpy.leaf(v, Nat.cpy(v))
    case Cn3197{l, r}:
      Ct3197.cpy.node(l, r, Ct3197.cpy(l), Ct3197.cpy(r))

law cmir3197_mir:
  for t: Ct3197
  {cmir3197(cmir3197(t)) == t : Ct3197}

def cmir3197_mir(t):
  match t:
    case Cl3197{v}:
      {==}
    case Cn3197{l, r}:
      %cmir3197_mir(l) : {Cn3197{cmir3197(cmir3197(l)), cmir3197(cmir3197(r))} == Cn3197{_, r} : Ct3197}
      %cmir3197_mir(r) : {Cn3197{cmir3197(cmir3197(l)), cmir3197(cmir3197(r))} == Cn3197{cmir3197(cmir3197(l)), _} : Ct3197}
      {==}

law csize3197_mir:
  for +t: Ct3197
