  for t: Ct2633
  {cmir2633(cmir2633(t)) == t : Ct2633}

def cmir2633_mir(t):
  match t:
    case Cl2633{v}:
      {==}
    case Cn2633{l, r}:
      %cmir2633_mir(l) : {Cn2633{cmir2633(cmir2633(l)), cmir2633(cmir2633(r))} == Cn2633{_, r} : Ct2633}
      %cmir2633_mir(r) : {Cn2633{cmir2633(cmir2633(l)), cmir2633(cmir2633(r))} == Cn2633{cmir2633(cmir2633(l)), _} : Ct2633}
