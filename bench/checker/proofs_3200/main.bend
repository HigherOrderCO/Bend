      %csize1640_mir(l) : {add(csize1640(cmir1640(r)), csize1640(cmir1640(l))) == add(_, csize1640(cmir1640(r))) : Nat}
      %add_comm(csize1640(cmir1640(l)), csize1640(cmir1640(r))) : {_ == add(csize1640(cmir1640(l)), csize1640(cmir1640(r))) : Nat}
