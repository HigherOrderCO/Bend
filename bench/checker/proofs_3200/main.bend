    case Cl5{v}:
      {==}
    case Cn5{l, r}:
      %cmir5_mir(l) : {Cn5{cmir5(cmir5(l)), cmir5(cmir5(r))} == Cn5{_, r} : Ct5}
      %cmir5_mir(r) : {Cn5{cmir5(cmir5(l)), cmir5(cmir5(r))} == Cn5{cmir5(cmir5(l)), _} : Ct5}
