law aadd891_comm:
  for a: An891
  for +b: An891
  {aadd891(a, b) == aadd891(b, a) : An891}

def aadd891_comm(a, b):
  match a:
    case Az891{}:
      %aadd891_zero(b) : {_ == aadd891(b, Az891{}) : An891}
      {==}
    case As891{a}:
