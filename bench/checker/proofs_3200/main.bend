def aadd2472_succ(a, b):
  match a:
    case Az2472{}:
      {==}
    case As2472{a}:
      %aadd2472_succ(a, b) : {As2472{As2472{aadd2472(a, b)}} == As2472{_} : An2472}
      {==}

law aadd2472_comm:
  for a: An2472
  for +b: An2472
  {aadd2472(a, b) == aadd2472(b, a) : An2472}

def aadd2472_comm(a, b):
  match a:
    case Az2472{}:
      %aadd2472_zero(b) : {_ == aadd2472(b, Az2472{}) : An2472}
      {==}
    case As2472{a}:
      %aadd2472_succ(b, a) : {As2472{aadd2472(a, b)} == _ : An2472}
      %aadd2472_comm(a, b) : {As2472{aadd2472(a, b)} == As2472{_} : An2472}
