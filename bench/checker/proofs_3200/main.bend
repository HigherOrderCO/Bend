law blen2989:
  for xs: Bl2989
  Nat

def blen2989(xs):
  match xs:
    case Bn2989{}:
      Z{}
    case Bc2989{h, t}:
      S{blen2989(t)}

law bcat2989_nil:
  for xs: Bl2989
  {bcat2989(xs, Bn2989{}) == xs : Bl2989}

def bcat2989_nil(xs):
  match xs:
    case Bn2989{}:
      {==}
    case Bc2989{h, t}:
      %bcat2989_nil(t) : {Bc2989{h, bcat2989(t, Bn2989{})} == Bc2989{h, _} : Bl2989}
      {==}

law bcat2989_assoc:
  for xs: Bl2989
  for -ys: Bl2989
  for -zs: Bl2989
  {bcat2989(bcat2989(xs, ys), zs) == bcat2989(xs, bcat2989(ys, zs)) : Bl2989}

def bcat2989_assoc(xs, ys, zs):
  match xs:
    case Bn2989{}:
      {==}
    case Bc2989{h, t}:
      %bcat2989_assoc(t, ys, zs) : {Bc2989{h, bcat2989(bcat2989(t, ys), zs)} == Bc2989{h, _} : Bl2989}
      {==}

law blen2989_cat:
  for xs: Bl2989
  for -ys: Bl2989
  {add(blen2989(xs), blen2989(ys)) == blen2989(bcat2989(xs, ys)) : Nat}

def blen2989_cat(xs, ys):
  match xs:
    case Bn2989{}:
      {==}
    case Bc2989{h, t}:
      %blen2989_cat(t, ys) : {S{add(blen2989(t), blen2989(ys))} == S{_} : Nat}
      {==}

