  Cn2471{lft: Ct2471, rgt: Ct2471}

law cmir2471:
  for t: Ct2471
  Ct2471

def cmir2471(t):
  match t:
    case Cl2471{v}:
      Cl2471{v}
    case Cn2471{l, r}:
      Cn2471{cmir2471(r), cmir2471(l)}

law csize2471:
  for t: Ct2471
  Nat

def csize2471(t):
  match t:
    case Cl2471{v}:
      S{Z{}}
    case Cn2471{l, r}:
      add(csize2471(l), csize2471(r))

law Ct2471.cpy:
  for t: Ct2471
  Pair(Cpy(Ct2471, t), Cpy(Ct2471, t))

law Ct2471.cpy.leaf:
  for -v: Nat
  for c: Pair(Cpy(Nat, v), Cpy(Nat, v))
  Pair(Cpy(Ct2471, Cl2471{v}), Cpy(Ct2471, Cl2471{v}))

def Ct2471.cpy.leaf(v, c):
  Tuple{Tuple{v1, e1}, Tuple{v2, e2}} = c
  Tuple{Tuple{Cl2471{v1}, cong(Nat, Ct2471, x => Cl2471{x}, v, v1, e1)}, Tuple{Cl2471{v2}, cong(Nat, Ct2471, x => Cl2471{x}, v, v2, e2)}}

law Ct2471.cpy.node:
  for -l: Ct2471
  for -r: Ct2471
  for cl: Pair(Cpy(Ct2471, l), Cpy(Ct2471, l))
  for cr: Pair(Cpy(Ct2471, r), Cpy(Ct2471, r))
  Pair(Cpy(Ct2471, Cn2471{l, r}), Cpy(Ct2471, Cn2471{l, r}))

def Ct2471.cpy.node(l, r, cl, cr):
  Tuple{Tuple{l1, el1}, Tuple{l2, el2}} = cl
  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn2471{l1, r1}, Equal.cong2(Ct2471, Ct2471, Ct2471, x => y => Cn2471{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn2471{l2, r2}, Equal.cong2(Ct2471, Ct2471, Ct2471, x => y => Cn2471{x, y}, l, l2, r, r2, el2, er2)}}

def Ct2471.cpy(t):
  match t:
    case Cl2471{v}:
      Ct2471.cpy.leaf(v, Nat.cpy(v))
    case Cn2471{l, r}:
      Ct2471.cpy.node(l, r, Ct2471.cpy(l), Ct2471.cpy(r))

law cmir2471_mir:
  for t: Ct2471
  {cmir2471(cmir2471(t)) == t : Ct2471}

def cmir2471_mir(t):
  match t:
    case Cl2471{v}:
      {==}
    case Cn2471{l, r}:
      %cmir2471_mir(l) : {Cn2471{cmir2471(cmir2471(l)), cmir2471(cmir2471(r))} == Cn2471{_, r} : Ct2471}
      %cmir2471_mir(r) : {Cn2471{cmir2471(cmir2471(l)), cmir2471(cmir2471(r))} == Cn2471{cmir2471(cmir2471(l)), _} : Ct2471}
      {==}

law csize2471_mir:
  for +t: Ct2471
  {csize2471(cmir2471(t)) == csize2471(t) : Nat}

