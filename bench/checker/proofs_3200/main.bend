  for ys: Bl2890
  Bl2890

def bcat2890(xs, ys):
  match xs:
    case Bn2890{}:
      ys
    case Bc2890{h, t}:
      Bc2890{h, bcat2890(t, ys)}

law blen2890:
  for xs: Bl2890
  Nat

def blen2890(xs):
  match xs:
    case Bn2890{}:
      Z{}
    case Bc2890{h, t}:
      S{blen2890(t)}

law bcat2890_nil:
  for xs: Bl2890
  {bcat2890(xs, Bn2890{}) == xs : Bl2890}

def bcat2890_nil(xs):
  match xs:
    case Bn2890{}:
      {==}
    case Bc2890{h, t}:
      %bcat2890_nil(t) : {Bc2890{h, bcat2890(t, Bn2890{})} == Bc2890{h, _} : Bl2890}
      {==}

law bcat2890_assoc:
  for xs: Bl2890
  for -ys: Bl2890
  for -zs: Bl2890
  {bcat2890(bcat2890(xs, ys), zs) == bcat2890(xs, bcat2890(ys, zs)) : Bl2890}

def bcat2890_assoc(xs, ys, zs):
  match xs:
    case Bn2890{}:
      {==}
    case Bc2890{h, t}:
      %bcat2890_assoc(t, ys, zs) : {Bc2890{h, bcat2890(bcat2890(t, ys), zs)} == Bc2890{h, _} : Bl2890}
      {==}

law blen2890_cat:
  for xs: Bl2890
  for -ys: Bl2890
  {add(blen2890(xs), blen2890(ys)) == blen2890(bcat2890(xs, ys)) : Nat}

def blen2890_cat(xs, ys):
  match xs:
    case Bn2890{}:
      {==}
    case Bc2890{h, t}:
      %blen2890_cat(t, ys) : {S{add(blen2890(t), blen2890(ys))} == S{_} : Nat}
      {==}

