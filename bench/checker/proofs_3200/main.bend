law cong:
  for -A: Type
  for -B: Type
  for -f: A -> B
  for -a: A
  for -b: A
  for  e: {a == b : A}
  {f(a) == f(b) : B}

def cong(A, B, f, a, b, e):
  %e : {f(a) == f(_) : B}
  {==}

type Nat is Data:
  Z{}
  S{pred: Nat}

type Sigma<-A: Type, -B: @-x: A -> Type> is Type:
  Tuple{fst: A, snd: B(fst)}

law Pair:
  for -A: Type
  for -B: Type
  Type

def Pair(A, B):
  Sigma<A, _ => B>

law Cpy:
  for -A: Type
  for -x: A
  Type

def Cpy(A, x):
  Sigma<A, y => {x == y : A}>

law Cpyable:
  for -T: Type
  Type

def Cpyable(T):
  @x: T -> Pair(Cpy(T, x), Cpy(T, x))

law Equal.cong2:
  for -A: Type
  for -B: Type
  for -C: Type
  for -f: A -> @y: B -> C
  for -a: A
  for -c: A
  for -b: B
  for -d: B
  for ea: {a == c : A}
  for eb: {b == d : B}
  {f(a)(b) == f(c)(d) : C}

def Equal.cong2(A, B, C, f, a, c, b, d, ea, eb):
  %eb : {f(a)(b) == f(c)(_) : C}
  %ea : {f(a)(b) == f(_)(b) : C}
  {==}

law add:
  for a: Nat
  for b: Nat
  Nat

def add(a, b):
  match a:
    case Z{}:
      b
    case S{a}:
      S{add(a, b)}

law Nat.cpy:
  for n: Nat
  Pair(Cpy(Nat, n), Cpy(Nat, n))

law Nat.cpy.succ:
  for -p: Nat
  for c: Pair(Cpy(Nat, p), Cpy(Nat, p))
  Pair(Cpy(Nat, S{p}), Cpy(Nat, S{p}))

def Nat.cpy.succ(p, c):
  Tuple{Tuple{a, ea}, Tuple{b, eb}} = c
  Tuple{Tuple{S{a}, cong(Nat, Nat, x => S{x}, p, a, ea)}, Tuple{S{b}, cong(Nat, Nat, x => S{x}, p, b, eb)}}

def Nat.cpy(n):
  match n:
    case Z{}:
      Tuple{Tuple{Z{}, {==}}, Tuple{Z{}, {==}}}
    case S{p}:
      Nat.cpy.succ(p, Nat.cpy(p))

law add_zero:
  for a: Nat
  {add(a, Z{}) == a : Nat}

def add_zero(a):
  match a:
    case Z{}:
      {==}
    case S{a}:
      %add_zero(a) : {S{add(a, Z{})} == S{_} : Nat}
      {==}

law add_succ:
  for a: Nat
  for -b: Nat
  {S{add(a, b)} == add(a, S{b}) : Nat}

def add_succ(a, b):
  match a:
    case Z{}:
      {==}
    case S{a}:
      %add_succ(a, b) : {S{S{add(a, b)}} == S{_} : Nat}
      {==}

law add_comm:
  for a: Nat
  for +b: Nat
  {add(a, b) == add(b, a) : Nat}

def add_comm(a, b):
  match a:
    case Z{}:
      %add_zero(b) : {_ == add(b, Z{}) : Nat}
      {==}
    case S{a}:
      %add_succ(b, a) : {S{add(a, b)} == _ : Nat}
      %add_comm(a, b) : {S{add(a, b)} == S{_} : Nat}
      {==}

type An0 is Data:
  Az0{}
  As0{pred: An0}

law aadd0:
  for a: An0
  for b: An0
  An0

def aadd0(a, b):
  match a:
    case Az0{}:
      b
    case As0{a}:
      As0{aadd0(a, b)}

law An0.cpy:
  for n: An0
  Pair(Cpy(An0, n), Cpy(An0, n))

law An0.cpy.succ:
  for -p: An0
  for c: Pair(Cpy(An0, p), Cpy(An0, p))
  Pair(Cpy(An0, As0{p}), Cpy(An0, As0{p}))

def An0.cpy.succ(p, c):
  Tuple{Tuple{a, ea}, Tuple{b, eb}} = c
  Tuple{Tuple{As0{a}, cong(An0, An0, x => As0{x}, p, a, ea)}, Tuple{As0{b}, cong(An0, An0, x => As0{x}, p, b, eb)}}

def An0.cpy(n):
  match n:
    case Az0{}:
      Tuple{Tuple{Az0{}, {==}}, Tuple{Az0{}, {==}}}
    case As0{p}:
      An0.cpy.succ(p, An0.cpy(p))

law aadd0_zero:
  for a: An0
  {aadd0(a, Az0{}) == a : An0}

def aadd0_zero(a):
  match a:
    case Az0{}:
      {==}
    case As0{a}:
      %aadd0_zero(a) : {As0{aadd0(a, Az0{})} == As0{_} : An0}
      {==}

law aadd0_succ:
  for a: An0
  for -b: An0
  {As0{aadd0(a, b)} == aadd0(a, As0{b}) : An0}

def aadd0_succ(a, b):
  match a:
    case Az0{}:
      {==}
    case As0{a}:
      %aadd0_succ(a, b) : {As0{As0{aadd0(a, b)}} == As0{_} : An0}
      {==}

law aadd0_comm:
  for a: An0
  for +b: An0
  {aadd0(a, b) == aadd0(b, a) : An0}

def aadd0_comm(a, b):
  match a:
    case Az0{}:
      %aadd0_zero(b) : {_ == aadd0(b, Az0{}) : An0}
      {==}
    case As0{a}:
      %aadd0_succ(b, a) : {As0{aadd0(a, b)} == _ : An0}
      %aadd0_comm(a, b) : {As0{aadd0(a, b)} == As0{_} : An0}
      {==}

type Bl1 is Data:
  Bn1{}
  Bc1{head: Nat, tail: Bl1}

law bcat1:
  for xs: Bl1
  for ys: Bl1
  Bl1

def bcat1(xs, ys):
  match xs:
    case Bn1{}:
      ys
    case Bc1{h, t}:
      Bc1{h, bcat1(t, ys)}

law blen1:
  for xs: Bl1
  Nat

def blen1(xs):
  match xs:
    case Bn1{}:
      Z{}
    case Bc1{h, t}:
      S{blen1(t)}

law bcat1_nil:
  for xs: Bl1
  {bcat1(xs, Bn1{}) == xs : Bl1}

def bcat1_nil(xs):
  match xs:
    case Bn1{}:
      {==}
    case Bc1{h, t}:
      %bcat1_nil(t) : {Bc1{h, bcat1(t, Bn1{})} == Bc1{h, _} : Bl1}
      {==}

law bcat1_assoc:
  for xs: Bl1
  for -ys: Bl1
  for -zs: Bl1
  {bcat1(bcat1(xs, ys), zs) == bcat1(xs, bcat1(ys, zs)) : Bl1}

def bcat1_assoc(xs, ys, zs):
  match xs:
    case Bn1{}:
      {==}
    case Bc1{h, t}:
      %bcat1_assoc(t, ys, zs) : {Bc1{h, bcat1(bcat1(t, ys), zs)} == Bc1{h, _} : Bl1}
      {==}

law blen1_cat:
  for xs: Bl1
  for -ys: Bl1
  {add(blen1(xs), blen1(ys)) == blen1(bcat1(xs, ys)) : Nat}

def blen1_cat(xs, ys):
  match xs:
    case Bn1{}:
      {==}
    case Bc1{h, t}:
      %blen1_cat(t, ys) : {S{add(blen1(t), blen1(ys))} == S{_} : Nat}
      {==}

type Ct2 is Data:
  Cl2{val: Nat}
  Cn2{lft: Ct2, rgt: Ct2}

law cmir2:
  for t: Ct2
  Ct2

def cmir2(t):
  match t:
    case Cl2{v}:
      Cl2{v}
    case Cn2{l, r}:
      Cn2{cmir2(r), cmir2(l)}

law csize2:
  for t: Ct2
  Nat

def csize2(t):
  match t:
    case Cl2{v}:
      S{Z{}}
    case Cn2{l, r}:
      add(csize2(l), csize2(r))

law Ct2.cpy:
  for t: Ct2
  Pair(Cpy(Ct2, t), Cpy(Ct2, t))

law Ct2.cpy.leaf:
  for -v: Nat
  for c: Pair(Cpy(Nat, v), Cpy(Nat, v))
  Pair(Cpy(Ct2, Cl2{v}), Cpy(Ct2, Cl2{v}))

def Ct2.cpy.leaf(v, c):
  Tuple{Tuple{v1, e1}, Tuple{v2, e2}} = c
  Tuple{Tuple{Cl2{v1}, cong(Nat, Ct2, x => Cl2{x}, v, v1, e1)}, Tuple{Cl2{v2}, cong(Nat, Ct2, x => Cl2{x}, v, v2, e2)}}

law Ct2.cpy.node:
  for -l: Ct2
  for -r: Ct2
  for cl: Pair(Cpy(Ct2, l), Cpy(Ct2, l))
  for cr: Pair(Cpy(Ct2, r), Cpy(Ct2, r))
  Pair(Cpy(Ct2, Cn2{l, r}), Cpy(Ct2, Cn2{l, r}))

def Ct2.cpy.node(l, r, cl, cr):
  Tuple{Tuple{l1, el1}, Tuple{l2, el2}} = cl
  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn2{l1, r1}, Equal.cong2(Ct2, Ct2, Ct2, x => y => Cn2{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn2{l2, r2}, Equal.cong2(Ct2, Ct2, Ct2, x => y => Cn2{x, y}, l, l2, r, r2, el2, er2)}}

def Ct2.cpy(t):
  match t:
    case Cl2{v}:
      Ct2.cpy.leaf(v, Nat.cpy(v))
    case Cn2{l, r}:
      Ct2.cpy.node(l, r, Ct2.cpy(l), Ct2.cpy(r))

law cmir2_mir:
  for t: Ct2
  {cmir2(cmir2(t)) == t : Ct2}

def cmir2_mir(t):
  match t:
    case Cl2{v}:
      {==}
    case Cn2{l, r}:
      %cmir2_mir(l) : {Cn2{cmir2(cmir2(l)), cmir2(cmir2(r))} == Cn2{_, r} : Ct2}
      %cmir2_mir(r) : {Cn2{cmir2(cmir2(l)), cmir2(cmir2(r))} == Cn2{cmir2(cmir2(l)), _} : Ct2}
      {==}

law csize2_mir:
  for +t: Ct2
  {csize2(cmir2(t)) == csize2(t) : Nat}

def csize2_mir(t):
  match t:
    case Cl2{v}:
      {==}
    case Cn2{l, r}:
      %csize2_mir(r) : {add(csize2(cmir2(r)), csize2(cmir2(l))) == add(csize2(l), _) : Nat}
      %csize2_mir(l) : {add(csize2(cmir2(r)), csize2(cmir2(l))) == add(_, csize2(cmir2(r))) : Nat}
      %add_comm(csize2(cmir2(l)), csize2(cmir2(r))) : {_ == add(csize2(cmir2(l)), csize2(cmir2(r))) : Nat}
      {==}

