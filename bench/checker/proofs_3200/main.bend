  match t:
    case Cl1640{v}:
      Cl1640{v}
    case Cn1640{l, r}:
      Cn1640{cmir1640(r), cmir1640(l)}

law csize1640:
  for t: Ct1640
  Nat

def csize1640(t):
  match t:
    case Cl1640{v}:
      S{Z{}}
    case Cn1640{l, r}:
      add(csize1640(l), csize1640(r))

law Ct1640.cpy:
  for t: Ct1640
  Pair(Cpy(Ct1640, t), Cpy(Ct1640, t))

law Ct1640.cpy.leaf:
  for -v: Nat
  for c: Pair(Cpy(Nat, v), Cpy(Nat, v))
  Pair(Cpy(Ct1640, Cl1640{v}), Cpy(Ct1640, Cl1640{v}))

def Ct1640.cpy.leaf(v, c):
  Tuple{Tuple{v1, e1}, Tuple{v2, e2}} = c
  Tuple{Tuple{Cl1640{v1}, cong(Nat, Ct1640, x => Cl1640{x}, v, v1, e1)}, Tuple{Cl1640{v2}, cong(Nat, Ct1640, x => Cl1640{x}, v, v2, e2)}}

law Ct1640.cpy.node:
  for -l: Ct1640
  for -r: Ct1640
  for cl: Pair(Cpy(Ct1640, l), Cpy(Ct1640, l))
  for cr: Pair(Cpy(Ct1640, r), Cpy(Ct1640, r))
  Pair(Cpy(Ct1640, Cn1640{l, r}), Cpy(Ct1640, Cn1640{l, r}))

def Ct1640.cpy.node(l, r, cl, cr):
  Tuple{Tuple{l1, el1}, Tuple{l2, el2}} = cl
  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn1640{l1, r1}, Equal.cong2(Ct1640, Ct1640, Ct1640, x => y => Cn1640{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn1640{l2, r2}, Equal.cong2(Ct1640, Ct1640, Ct1640, x => y => Cn1640{x, y}, l, l2, r, r2, el2, er2)}}

def Ct1640.cpy(t):
  match t:
    case Cl1640{v}:
      Ct1640.cpy.leaf(v, Nat.cpy(v))
    case Cn1640{l, r}:
      Ct1640.cpy.node(l, r, Ct1640.cpy(l), Ct1640.cpy(r))

law cmir1640_mir:
  for t: Ct1640
  {cmir1640(cmir1640(t)) == t : Ct1640}

def cmir1640_mir(t):
  match t:
    case Cl1640{v}:
      {==}
    case Cn1640{l, r}:
      %cmir1640_mir(l) : {Cn1640{cmir1640(cmir1640(l)), cmir1640(cmir1640(r))} == Cn1640{_, r} : Ct1640}
      %cmir1640_mir(r) : {Cn1640{cmir1640(cmir1640(l)), cmir1640(cmir1640(r))} == Cn1640{cmir1640(cmir1640(l)), _} : Ct1640}
