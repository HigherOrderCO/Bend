  for ys: Bl2632
  Bl2632

def bcat2632(xs, ys):
  match xs:
    case Bn2632{}:
      ys
    case Bc2632{h, t}:
      Bc2632{h, bcat2632(t, ys)}

law blen2632:
  for xs: Bl2632
  Nat

def blen2632(xs):
  match xs:
    case Bn2632{}:
      Z{}
    case Bc2632{h, t}:
      S{blen2632(t)}

law bcat2632_nil:
  for xs: Bl2632
  {bcat2632(xs, Bn2632{}) == xs : Bl2632}

def bcat2632_nil(xs):
  match xs:
    case Bn2632{}:
      {==}
    case Bc2632{h, t}:
      %bcat2632_nil(t) : {Bc2632{h, bcat2632(t, Bn2632{})} == Bc2632{h, _} : Bl2632}
      {==}

law bcat2632_assoc:
  for xs: Bl2632
  for -ys: Bl2632
  for -zs: Bl2632
  {bcat2632(bcat2632(xs, ys), zs) == bcat2632(xs, bcat2632(ys, zs)) : Bl2632}

