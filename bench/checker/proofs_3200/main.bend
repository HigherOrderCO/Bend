  for -l: Ct2633
  for -r: Ct2633
  for cl: Pair(Cpy(Ct2633, l), Cpy(Ct2633, l))
  for cr: Pair(Cpy(Ct2633, r), Cpy(Ct2633, r))
  Pair(Cpy(Ct2633, Cn2633{l, r}), Cpy(Ct2633, Cn2633{l, r}))

def Ct2633.cpy.node(l, r, cl, cr):
  Tuple{Tuple{l1, el1}, Tuple{l2, el2}} = cl
  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn2633{l1, r1}, Equal.cong2(Ct2633, Ct2633, Ct2633, x => y => Cn2633{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn2633{l2, r2}, Equal.cong2(Ct2633, Ct2633, Ct2633, x => y => Cn2633{x, y}, l, l2, r, r2, el2, er2)}}

def Ct2633.cpy(t):
