  Cn2600{lft: Ct2600, rgt: Ct2600}

law cmir2600:
  for t: Ct2600
  Ct2600

def cmir2600(t):
  match t:
    case Cl2600{v}:
      Cl2600{v}
    case Cn2600{l, r}:
      Cn2600{cmir2600(r), cmir2600(l)}

law csize2600:
  for t: Ct2600
  Nat

def csize2600(t):
  match t:
    case Cl2600{v}:
      S{Z{}}
    case Cn2600{l, r}:
      add(csize2600(l), csize2600(r))

law Ct2600.cpy:
  for t: Ct2600
  Pair(Cpy(Ct2600, t), Cpy(Ct2600, t))

law Ct2600.cpy.leaf:
  for -v: Nat
  for c: Pair(Cpy(Nat, v), Cpy(Nat, v))
  Pair(Cpy(Ct2600, Cl2600{v}), Cpy(Ct2600, Cl2600{v}))

def Ct2600.cpy.leaf(v, c):
  Tuple{Tuple{v1, e1}, Tuple{v2, e2}} = c
  Tuple{Tuple{Cl2600{v1}, cong(Nat, Ct2600, x => Cl2600{x}, v, v1, e1)}, Tuple{Cl2600{v2}, cong(Nat, Ct2600, x => Cl2600{x}, v, v2, e2)}}

law Ct2600.cpy.node:
  for -l: Ct2600
  for -r: Ct2600
  for cl: Pair(Cpy(Ct2600, l), Cpy(Ct2600, l))
  for cr: Pair(Cpy(Ct2600, r), Cpy(Ct2600, r))
  Pair(Cpy(Ct2600, Cn2600{l, r}), Cpy(Ct2600, Cn2600{l, r}))

def Ct2600.cpy.node(l, r, cl, cr):
  Tuple{Tuple{l1, el1}, Tuple{l2, el2}} = cl
  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn2600{l1, r1}, Equal.cong2(Ct2600, Ct2600, Ct2600, x => y => Cn2600{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn2600{l2, r2}, Equal.cong2(Ct2600, Ct2600, Ct2600, x => y => Cn2600{x, y}, l, l2, r, r2, el2, er2)}}

def Ct2600.cpy(t):
  match t:
    case Cl2600{v}:
      Ct2600.cpy.leaf(v, Nat.cpy(v))
    case Cn2600{l, r}:
      Ct2600.cpy.node(l, r, Ct2600.cpy(l), Ct2600.cpy(r))

law cmir2600_mir:
  for t: Ct2600
  {cmir2600(cmir2600(t)) == t : Ct2600}

def cmir2600_mir(t):
  match t:
    case Cl2600{v}:
      {==}
    case Cn2600{l, r}:
      %cmir2600_mir(l) : {Cn2600{cmir2600(cmir2600(l)), cmir2600(cmir2600(r))} == Cn2600{_, r} : Ct2600}
      %cmir2600_mir(r) : {Cn2600{cmir2600(cmir2600(l)), cmir2600(cmir2600(r))} == Cn2600{cmir2600(cmir2600(l)), _} : Ct2600}
      {==}

law csize2600_mir:
  for +t: Ct2600
  {csize2600(cmir2600(t)) == csize2600(t) : Nat}

def csize2600_mir(t):
  match t:
    case Cl2600{v}:
      {==}
    case Cn2600{l, r}:
      %csize2600_mir(r) : {add(csize2600(cmir2600(r)), csize2600(cmir2600(l))) == add(csize2600(l), _) : Nat}
      %csize2600_mir(l) : {add(csize2600(cmir2600(r)), csize2600(cmir2600(l))) == add(_, csize2600(cmir2600(r))) : Nat}
      %add_comm(csize2600(cmir2600(l)), csize2600(cmir2600(r))) : {_ == add(csize2600(cmir2600(l)), csize2600(cmir2600(r))) : Nat}
      {==}

type An2601 is Data:
  Az2601{}
  As2601{pred: An2601}

law aadd2601:
  for a: An2601
  for b: An2601
  An2601

def aadd2601(a, b):
  match a:
    case Az2601{}:
      b
    case As2601{a}:
      As2601{aadd2601(a, b)}

law An2601.cpy:
  for n: An2601
  Pair(Cpy(An2601, n), Cpy(An2601, n))

law An2601.cpy.succ:
  for -p: An2601
  for c: Pair(Cpy(An2601, p), Cpy(An2601, p))
  Pair(Cpy(An2601, As2601{p}), Cpy(An2601, As2601{p}))

def An2601.cpy.succ(p, c):
  Tuple{Tuple{a, ea}, Tuple{b, eb}} = c
  Tuple{Tuple{As2601{a}, cong(An2601, An2601, x => As2601{x}, p, a, ea)}, Tuple{As2601{b}, cong(An2601, An2601, x => As2601{x}, p, b, eb)}}

def An2601.cpy(n):
  match n:
    case Az2601{}:
      Tuple{Tuple{Az2601{}, {==}}, Tuple{Az2601{}, {==}}}
    case As2601{p}:
      An2601.cpy.succ(p, An2601.cpy(p))

law aadd2601_zero:
  for a: An2601
  {aadd2601(a, Az2601{}) == a : An2601}

def aadd2601_zero(a):
  match a:
    case Az2601{}:
      {==}
    case As2601{a}:
      %aadd2601_zero(a) : {As2601{aadd2601(a, Az2601{})} == As2601{_} : An2601}
      {==}

law aadd2601_succ:
  for a: An2601
  for -b: An2601
  {As2601{aadd2601(a, b)} == aadd2601(a, As2601{b}) : An2601}

def aadd2601_succ(a, b):
  match a:
    case Az2601{}:
      {==}
    case As2601{a}:
      %aadd2601_succ(a, b) : {As2601{As2601{aadd2601(a, b)}} == As2601{_} : An2601}
      {==}

law aadd2601_comm:
  for a: An2601
  for +b: An2601
  {aadd2601(a, b) == aadd2601(b, a) : An2601}

def aadd2601_comm(a, b):
  match a:
    case Az2601{}:
      %aadd2601_zero(b) : {_ == aadd2601(b, Az2601{}) : An2601}
      {==}
    case As2601{a}:
      %aadd2601_succ(b, a) : {As2601{aadd2601(a, b)} == _ : An2601}
      %aadd2601_comm(a, b) : {As2601{aadd2601(a, b)} == As2601{_} : An2601}
      {==}

type Bl2602 is Data:
  Bn2602{}
  Bc2602{head: Nat, tail: Bl2602}

law bcat2602:
  for xs: Bl2602
  for ys: Bl2602
  Bl2602

def bcat2602(xs, ys):
  match xs:
    case Bn2602{}:
      ys
    case Bc2602{h, t}:
      Bc2602{h, bcat2602(t, ys)}

law blen2602:
  for xs: Bl2602
  Nat

def blen2602(xs):
  match xs:
    case Bn2602{}:
      Z{}
    case Bc2602{h, t}:
      S{blen2602(t)}

law bcat2602_nil:
  for xs: Bl2602
  {bcat2602(xs, Bn2602{}) == xs : Bl2602}

def bcat2602_nil(xs):
  match xs:
    case Bn2602{}:
      {==}
    case Bc2602{h, t}:
      %bcat2602_nil(t) : {Bc2602{h, bcat2602(t, Bn2602{})} == Bc2602{h, _} : Bl2602}
      {==}

law bcat2602_assoc:
  for xs: Bl2602
  for -ys: Bl2602
  for -zs: Bl2602
  {bcat2602(bcat2602(xs, ys), zs) == bcat2602(xs, bcat2602(ys, zs)) : Bl2602}

def bcat2602_assoc(xs, ys, zs):
  match xs:
    case Bn2602{}:
      {==}
    case Bc2602{h, t}:
      %bcat2602_assoc(t, ys, zs) : {Bc2602{h, bcat2602(bcat2602(t, ys), zs)} == Bc2602{h, _} : Bl2602}
      {==}

law blen2602_cat:
  for xs: Bl2602
  for -ys: Bl2602
  {add(blen2602(xs), blen2602(ys)) == blen2602(bcat2602(xs, ys)) : Nat}

def blen2602_cat(xs, ys):
  match xs:
    case Bn2602{}:
      {==}
    case Bc2602{h, t}:
      %blen2602_cat(t, ys) : {S{add(blen2602(t), blen2602(ys))} == S{_} : Nat}
      {==}

