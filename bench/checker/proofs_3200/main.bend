law blen2149:
  for xs: Bl2149
  Nat

def blen2149(xs):
  match xs:
    case Bn2149{}:
      Z{}
    case Bc2149{h, t}:
      S{blen2149(t)}

law bcat2149_nil:
  for xs: Bl2149
  {bcat2149(xs, Bn2149{}) == xs : Bl2149}

