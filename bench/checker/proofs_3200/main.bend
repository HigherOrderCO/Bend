  for ys: Bl1639
  Bl1639

def bcat1639(xs, ys):
  match xs:
    case Bn1639{}:
      ys
    case Bc1639{h, t}:
      Bc1639{h, bcat1639(t, ys)}

law blen1639:
  for xs: Bl1639
  Nat

def blen1639(xs):
  match xs:
    case Bn1639{}:
      Z{}
    case Bc1639{h, t}:
      S{blen1639(t)}

law bcat1639_nil:
  for xs: Bl1639
  {bcat1639(xs, Bn1639{}) == xs : Bl1639}

def bcat1639_nil(xs):
  match xs:
    case Bn1639{}:
      {==}
    case Bc1639{h, t}:
      %bcat1639_nil(t) : {Bc1639{h, bcat1639(t, Bn1639{})} == Bc1639{h, _} : Bl1639}
      {==}

law bcat1639_assoc:
  for xs: Bl1639
  for -ys: Bl1639
  for -zs: Bl1639
  {bcat1639(bcat1639(xs, ys), zs) == bcat1639(xs, bcat1639(ys, zs)) : Bl1639}

