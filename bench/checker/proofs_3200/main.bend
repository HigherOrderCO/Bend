  Tuple{Tuple{l1, el1}, Tuple{l2, el2}} = cl
  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn2642{l1, r1}, Equal.cong2(Ct2642, Ct2642, Ct2642, x => y => Cn2642{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn2642{l2, r2}, Equal.cong2(Ct2642, Ct2642, Ct2642, x => y => Cn2642{x, y}, l, l2, r, r2, el2, er2)}}

