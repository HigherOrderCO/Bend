  match a:
    case Az2148{}:
      %aadd2148_zero(b) : {_ == aadd2148(b, Az2148{}) : An2148}
      {==}
    case As2148{a}:
      %aadd2148_succ(b, a) : {As2148{aadd2148(a, b)} == _ : An2148}
      %aadd2148_comm(a, b) : {As2148{aadd2148(a, b)} == As2148{_} : An2148}
