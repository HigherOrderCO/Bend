  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn2045{l1, r1}, Equal.cong2(Ct2045, Ct2045, Ct2045, x => y => Cn2045{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn2045{l2, r2}, Equal.cong2(Ct2045, Ct2045, Ct2045, x => y => Cn2045{x, y}, l, l2, r, r2, el2, er2)}}

