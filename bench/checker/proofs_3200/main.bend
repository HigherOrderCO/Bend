      {==}
    case Cn2471{l, r}:
      %csize2471_mir(r) : {add(csize2471(cmir2471(r)), csize2471(cmir2471(l))) == add(csize2471(l), _) : Nat}
      %csize2471_mir(l) : {add(csize2471(cmir2471(r)), csize2471(cmir2471(l))) == add(_, csize2471(cmir2471(r))) : Nat}
      %add_comm(csize2471(cmir2471(l)), csize2471(cmir2471(r))) : {_ == add(csize2471(cmir2471(l)), csize2471(cmir2471(r))) : Nat}
