  Bc310{head: Nat, tail: Bl310}

law bcat310:
  for xs: Bl310
  for ys: Bl310
  Bl310

def bcat310(xs, ys):
  match xs:
    case Bn310{}:
      ys
    case Bc310{h, t}:
      Bc310{h, bcat310(t, ys)}

law blen310:
  for xs: Bl310
  Nat

def blen310(xs):
  match xs:
    case Bn310{}:
      Z{}
    case Bc310{h, t}:
      S{blen310(t)}

law bcat310_nil:
  for xs: Bl310
  {bcat310(xs, Bn310{}) == xs : Bl310}

def bcat310_nil(xs):
  match xs:
    case Bn310{}:
      {==}
    case Bc310{h, t}:
      %bcat310_nil(t) : {Bc310{h, bcat310(t, Bn310{})} == Bc310{h, _} : Bl310}
      {==}

law bcat310_assoc:
  for xs: Bl310
  for -ys: Bl310
  for -zs: Bl310
  {bcat310(bcat310(xs, ys), zs) == bcat310(xs, bcat310(ys, zs)) : Bl310}

def bcat310_assoc(xs, ys, zs):
  match xs:
    case Bn310{}:
      {==}
    case Bc310{h, t}:
      %bcat310_assoc(t, ys, zs) : {Bc310{h, bcat310(bcat310(t, ys), zs)} == Bc310{h, _} : Bl310}
      {==}

law blen310_cat:
  for xs: Bl310
  for -ys: Bl310
  {add(blen310(xs), blen310(ys)) == blen310(bcat310(xs, ys)) : Nat}

def blen310_cat(xs, ys):
  match xs:
    case Bn310{}:
      {==}
    case Bc310{h, t}:
      %blen310_cat(t, ys) : {S{add(blen310(t), blen310(ys))} == S{_} : Nat}
      {==}

type Ct311 is Data:
  Cl311{val: Nat}
  Cn311{lft: Ct311, rgt: Ct311}

law cmir311:
  for t: Ct311
  Ct311

def cmir311(t):
  match t:
    case Cl311{v}:
      Cl311{v}
    case Cn311{l, r}:
      Cn311{cmir311(r), cmir311(l)}

law csize311:
  for t: Ct311
  Nat

def csize311(t):
  match t:
    case Cl311{v}:
      S{Z{}}
    case Cn311{l, r}:
      add(csize311(l), csize311(r))

law Ct311.cpy:
  for t: Ct311
  Pair(Cpy(Ct311, t), Cpy(Ct311, t))

law Ct311.cpy.leaf:
  for -v: Nat
  for c: Pair(Cpy(Nat, v), Cpy(Nat, v))
  Pair(Cpy(Ct311, Cl311{v}), Cpy(Ct311, Cl311{v}))

def Ct311.cpy.leaf(v, c):
  Tuple{Tuple{v1, e1}, Tuple{v2, e2}} = c
  Tuple{Tuple{Cl311{v1}, cong(Nat, Ct311, x => Cl311{x}, v, v1, e1)}, Tuple{Cl311{v2}, cong(Nat, Ct311, x => Cl311{x}, v, v2, e2)}}

law Ct311.cpy.node:
  for -l: Ct311
  for -r: Ct311
  for cl: Pair(Cpy(Ct311, l), Cpy(Ct311, l))
  for cr: Pair(Cpy(Ct311, r), Cpy(Ct311, r))
  Pair(Cpy(Ct311, Cn311{l, r}), Cpy(Ct311, Cn311{l, r}))

def Ct311.cpy.node(l, r, cl, cr):
  Tuple{Tuple{l1, el1}, Tuple{l2, el2}} = cl
  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn311{l1, r1}, Equal.cong2(Ct311, Ct311, Ct311, x => y => Cn311{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn311{l2, r2}, Equal.cong2(Ct311, Ct311, Ct311, x => y => Cn311{x, y}, l, l2, r, r2, el2, er2)}}

def Ct311.cpy(t):
  match t:
    case Cl311{v}:
      Ct311.cpy.leaf(v, Nat.cpy(v))
    case Cn311{l, r}:
      Ct311.cpy.node(l, r, Ct311.cpy(l), Ct311.cpy(r))

law cmir311_mir:
  for t: Ct311
  {cmir311(cmir311(t)) == t : Ct311}

def cmir311_mir(t):
  match t:
    case Cl311{v}:
      {==}
    case Cn311{l, r}:
      %cmir311_mir(l) : {Cn311{cmir311(cmir311(l)), cmir311(cmir311(r))} == Cn311{_, r} : Ct311}
      %cmir311_mir(r) : {Cn311{cmir311(cmir311(l)), cmir311(cmir311(r))} == Cn311{cmir311(cmir311(l)), _} : Ct311}
      {==}

law csize311_mir:
  for +t: Ct311
  {csize311(cmir311(t)) == csize311(t) : Nat}

def csize311_mir(t):
  match t:
    case Cl311{v}:
      {==}
    case Cn311{l, r}:
      %csize311_mir(r) : {add(csize311(cmir311(r)), csize311(cmir311(l))) == add(csize311(l), _) : Nat}
      %csize311_mir(l) : {add(csize311(cmir311(r)), csize311(cmir311(l))) == add(_, csize311(cmir311(r))) : Nat}
      %add_comm(csize311(cmir311(l)), csize311(cmir311(r))) : {_ == add(csize311(cmir311(l)), csize311(cmir311(r))) : Nat}
      {==}

type An312 is Data:
  Az312{}
  As312{pred: An312}

law aadd312:
  for a: An312
  for b: An312
  An312

def aadd312(a, b):
  match a:
    case Az312{}:
      b
    case As312{a}:
      As312{aadd312(a, b)}

law An312.cpy:
  for n: An312
  Pair(Cpy(An312, n), Cpy(An312, n))

law An312.cpy.succ:
  for -p: An312
  for c: Pair(Cpy(An312, p), Cpy(An312, p))
  Pair(Cpy(An312, As312{p}), Cpy(An312, As312{p}))

def An312.cpy.succ(p, c):
  Tuple{Tuple{a, ea}, Tuple{b, eb}} = c
  Tuple{Tuple{As312{a}, cong(An312, An312, x => As312{x}, p, a, ea)}, Tuple{As312{b}, cong(An312, An312, x => As312{x}, p, b, eb)}}

def An312.cpy(n):
  match n:
    case Az312{}:
      Tuple{Tuple{Az312{}, {==}}, Tuple{Az312{}, {==}}}
    case As312{p}:
      An312.cpy.succ(p, An312.cpy(p))

law aadd312_zero:
  for a: An312
  {aadd312(a, Az312{}) == a : An312}

def aadd312_zero(a):
  match a:
    case Az312{}:
      {==}
    case As312{a}:
      %aadd312_zero(a) : {As312{aadd312(a, Az312{})} == As312{_} : An312}
      {==}

law aadd312_succ:
  for a: An312
  for -b: An312
  {As312{aadd312(a, b)} == aadd312(a, As312{b}) : An312}

def aadd312_succ(a, b):
  match a:
    case Az312{}:
      {==}
    case As312{a}:
      %aadd312_succ(a, b) : {As312{As312{aadd312(a, b)}} == As312{_} : An312}
      {==}

law aadd312_comm:
  for a: An312
  for +b: An312
  {aadd312(a, b) == aadd312(b, a) : An312}

def aadd312_comm(a, b):
  match a:
    case Az312{}:
      %aadd312_zero(b) : {_ == aadd312(b, Az312{}) : An312}
      {==}
    case As312{a}:
      %aadd312_succ(b, a) : {As312{aadd312(a, b)} == _ : An312}
      %aadd312_comm(a, b) : {As312{aadd312(a, b)} == As312{_} : An312}
      {==}

