  Cn3116{lft: Ct3116, rgt: Ct3116}

law cmir3116:
  for t: Ct3116
  Ct3116

def cmir3116(t):
  match t:
    case Cl3116{v}:
      Cl3116{v}
    case Cn3116{l, r}:
      Cn3116{cmir3116(r), cmir3116(l)}

law csize3116:
  for t: Ct3116
  Nat

def csize3116(t):
  match t:
    case Cl3116{v}:
      S{Z{}}
    case Cn3116{l, r}:
      add(csize3116(l), csize3116(r))

law Ct3116.cpy:
  for t: Ct3116
  Pair(Cpy(Ct3116, t), Cpy(Ct3116, t))

law Ct3116.cpy.leaf:
  for -v: Nat
  for c: Pair(Cpy(Nat, v), Cpy(Nat, v))
  Pair(Cpy(Ct3116, Cl3116{v}), Cpy(Ct3116, Cl3116{v}))

def Ct3116.cpy.leaf(v, c):
  Tuple{Tuple{v1, e1}, Tuple{v2, e2}} = c
  Tuple{Tuple{Cl3116{v1}, cong(Nat, Ct3116, x => Cl3116{x}, v, v1, e1)}, Tuple{Cl3116{v2}, cong(Nat, Ct3116, x => Cl3116{x}, v, v2, e2)}}

law Ct3116.cpy.node:
  for -l: Ct3116
  for -r: Ct3116
  for cl: Pair(Cpy(Ct3116, l), Cpy(Ct3116, l))
  for cr: Pair(Cpy(Ct3116, r), Cpy(Ct3116, r))
  Pair(Cpy(Ct3116, Cn3116{l, r}), Cpy(Ct3116, Cn3116{l, r}))

def Ct3116.cpy.node(l, r, cl, cr):
  Tuple{Tuple{l1, el1}, Tuple{l2, el2}} = cl
  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn3116{l1, r1}, Equal.cong2(Ct3116, Ct3116, Ct3116, x => y => Cn3116{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn3116{l2, r2}, Equal.cong2(Ct3116, Ct3116, Ct3116, x => y => Cn3116{x, y}, l, l2, r, r2, el2, er2)}}

def Ct3116.cpy(t):
  match t:
    case Cl3116{v}:
      Ct3116.cpy.leaf(v, Nat.cpy(v))
    case Cn3116{l, r}:
      Ct3116.cpy.node(l, r, Ct3116.cpy(l), Ct3116.cpy(r))

law cmir3116_mir:
  for t: Ct3116
  {cmir3116(cmir3116(t)) == t : Ct3116}

def cmir3116_mir(t):
  match t:
    case Cl3116{v}:
      {==}
    case Cn3116{l, r}:
      %cmir3116_mir(l) : {Cn3116{cmir3116(cmir3116(l)), cmir3116(cmir3116(r))} == Cn3116{_, r} : Ct3116}
      %cmir3116_mir(r) : {Cn3116{cmir3116(cmir3116(l)), cmir3116(cmir3116(r))} == Cn3116{cmir3116(cmir3116(l)), _} : Ct3116}
      {==}

law csize3116_mir:
  for +t: Ct3116
  {csize3116(cmir3116(t)) == csize3116(t) : Nat}

def csize3116_mir(t):
  match t:
    case Cl3116{v}:
      {==}
    case Cn3116{l, r}:
      %csize3116_mir(r) : {add(csize3116(cmir3116(r)), csize3116(cmir3116(l))) == add(csize3116(l), _) : Nat}
      %csize3116_mir(l) : {add(csize3116(cmir3116(r)), csize3116(cmir3116(l))) == add(_, csize3116(cmir3116(r))) : Nat}
      %add_comm(csize3116(cmir3116(l)), csize3116(cmir3116(r))) : {_ == add(csize3116(cmir3116(l)), csize3116(cmir3116(r))) : Nat}
      {==}

type An3117 is Data:
  Az3117{}
  As3117{pred: An3117}

law aadd3117:
  for a: An3117
  for b: An3117
  An3117

def aadd3117(a, b):
  match a:
    case Az3117{}:
      b
    case As3117{a}:
      As3117{aadd3117(a, b)}

law An3117.cpy:
  for n: An3117
  Pair(Cpy(An3117, n), Cpy(An3117, n))

law An3117.cpy.succ:
  for -p: An3117
  for c: Pair(Cpy(An3117, p), Cpy(An3117, p))
  Pair(Cpy(An3117, As3117{p}), Cpy(An3117, As3117{p}))

def An3117.cpy.succ(p, c):
  Tuple{Tuple{a, ea}, Tuple{b, eb}} = c
  Tuple{Tuple{As3117{a}, cong(An3117, An3117, x => As3117{x}, p, a, ea)}, Tuple{As3117{b}, cong(An3117, An3117, x => As3117{x}, p, b, eb)}}

def An3117.cpy(n):
  match n:
    case Az3117{}:
      Tuple{Tuple{Az3117{}, {==}}, Tuple{Az3117{}, {==}}}
    case As3117{p}:
      An3117.cpy.succ(p, An3117.cpy(p))

law aadd3117_zero:
  for a: An3117
  {aadd3117(a, Az3117{}) == a : An3117}

def aadd3117_zero(a):
  match a:
    case Az3117{}:
      {==}
    case As3117{a}:
      %aadd3117_zero(a) : {As3117{aadd3117(a, Az3117{})} == As3117{_} : An3117}
      {==}

law aadd3117_succ:
  for a: An3117
  for -b: An3117
  {As3117{aadd3117(a, b)} == aadd3117(a, As3117{b}) : An3117}

def aadd3117_succ(a, b):
  match a:
    case Az3117{}:
      {==}
    case As3117{a}:
      %aadd3117_succ(a, b) : {As3117{As3117{aadd3117(a, b)}} == As3117{_} : An3117}
      {==}

law aadd3117_comm:
  for a: An3117
  for +b: An3117
  {aadd3117(a, b) == aadd3117(b, a) : An3117}

def aadd3117_comm(a, b):
  match a:
    case Az3117{}:
      %aadd3117_zero(b) : {_ == aadd3117(b, Az3117{}) : An3117}
      {==}
    case As3117{a}:
      %aadd3117_succ(b, a) : {As3117{aadd3117(a, b)} == _ : An3117}
      %aadd3117_comm(a, b) : {As3117{aadd3117(a, b)} == As3117{_} : An3117}
      {==}

type Bl3118 is Data:
  Bn3118{}
  Bc3118{head: Nat, tail: Bl3118}

law bcat3118:
  for xs: Bl3118
  for ys: Bl3118
  Bl3118

def bcat3118(xs, ys):
  match xs:
    case Bn3118{}:
      ys
    case Bc3118{h, t}:
      Bc3118{h, bcat3118(t, ys)}

law blen3118:
  for xs: Bl3118
  Nat

def blen3118(xs):
  match xs:
    case Bn3118{}:
      Z{}
    case Bc3118{h, t}:
      S{blen3118(t)}

law bcat3118_nil:
  for xs: Bl3118
  {bcat3118(xs, Bn3118{}) == xs : Bl3118}

def bcat3118_nil(xs):
  match xs:
    case Bn3118{}:
      {==}
    case Bc3118{h, t}:
      %bcat3118_nil(t) : {Bc3118{h, bcat3118(t, Bn3118{})} == Bc3118{h, _} : Bl3118}
      {==}

law bcat3118_assoc:
  for xs: Bl3118
  for -ys: Bl3118
  for -zs: Bl3118
  {bcat3118(bcat3118(xs, ys), zs) == bcat3118(xs, bcat3118(ys, zs)) : Bl3118}

def bcat3118_assoc(xs, ys, zs):
  match xs:
    case Bn3118{}:
      {==}
    case Bc3118{h, t}:
      %bcat3118_assoc(t, ys, zs) : {Bc3118{h, bcat3118(bcat3118(t, ys), zs)} == Bc3118{h, _} : Bl3118}
      {==}

law blen3118_cat:
  for xs: Bl3118
  for -ys: Bl3118
  {add(blen3118(xs), blen3118(ys)) == blen3118(bcat3118(xs, ys)) : Nat}

def blen3118_cat(xs, ys):
  match xs:
    case Bn3118{}:
      {==}
    case Bc3118{h, t}:
      %blen3118_cat(t, ys) : {S{add(blen3118(t), blen3118(ys))} == S{_} : Nat}
      {==}

