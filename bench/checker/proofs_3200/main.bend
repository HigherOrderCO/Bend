  for -l: Ct890
  for -r: Ct890
  for cl: Pair(Cpy(Ct890, l), Cpy(Ct890, l))
  for cr: Pair(Cpy(Ct890, r), Cpy(Ct890, r))
  Pair(Cpy(Ct890, Cn890{l, r}), Cpy(Ct890, Cn890{l, r}))

def Ct890.cpy.node(l, r, cl, cr):
  Tuple{Tuple{l1, el1}, Tuple{l2, el2}} = cl
  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn890{l1, r1}, Equal.cong2(Ct890, Ct890, Ct890, x => y => Cn890{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn890{l2, r2}, Equal.cong2(Ct890, Ct890, Ct890, x => y => Cn890{x, y}, l, l2, r, r2, el2, er2)}}

