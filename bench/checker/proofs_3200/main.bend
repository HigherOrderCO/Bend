def csize3197_mir(t):
  match t:
    case Cl3197{v}:
      {==}
    case Cn3197{l, r}:
      %csize3197_mir(r) : {add(csize3197(cmir3197(r)), csize3197(cmir3197(l))) == add(csize3197(l), _) : Nat}
      %csize3197_mir(l) : {add(csize3197(cmir3197(r)), csize3197(cmir3197(l))) == add(_, csize3197(cmir3197(r))) : Nat}
      %add_comm(csize3197(cmir3197(l)), csize3197(cmir3197(r))) : {_ == add(csize3197(cmir3197(l)), csize3197(cmir3197(r))) : Nat}
      {==}

type An3198 is Data:
  Az3198{}
  As3198{pred: An3198}

law aadd3198:
  for a: An3198
  for b: An3198
  An3198

def aadd3198(a, b):
  match a:
    case Az3198{}:
      b
    case As3198{a}:
      As3198{aadd3198(a, b)}

law An3198.cpy:
  for n: An3198
  Pair(Cpy(An3198, n), Cpy(An3198, n))

law An3198.cpy.succ:
  for -p: An3198
  for c: Pair(Cpy(An3198, p), Cpy(An3198, p))
  Pair(Cpy(An3198, As3198{p}), Cpy(An3198, As3198{p}))

def An3198.cpy.succ(p, c):
  Tuple{Tuple{a, ea}, Tuple{b, eb}} = c
  Tuple{Tuple{As3198{a}, cong(An3198, An3198, x => As3198{x}, p, a, ea)}, Tuple{As3198{b}, cong(An3198, An3198, x => As3198{x}, p, b, eb)}}

def An3198.cpy(n):
  match n:
    case Az3198{}:
      Tuple{Tuple{Az3198{}, {==}}, Tuple{Az3198{}, {==}}}
    case As3198{p}:
      An3198.cpy.succ(p, An3198.cpy(p))

law aadd3198_zero:
  for a: An3198
  {aadd3198(a, Az3198{}) == a : An3198}

def aadd3198_zero(a):
  match a:
    case Az3198{}:
      {==}
    case As3198{a}:
      %aadd3198_zero(a) : {As3198{aadd3198(a, Az3198{})} == As3198{_} : An3198}
      {==}

law aadd3198_succ:
  for a: An3198
  for -b: An3198
  {As3198{aadd3198(a, b)} == aadd3198(a, As3198{b}) : An3198}

def aadd3198_succ(a, b):
  match a:
    case Az3198{}:
      {==}
    case As3198{a}:
      %aadd3198_succ(a, b) : {As3198{As3198{aadd3198(a, b)}} == As3198{_} : An3198}
      {==}

law aadd3198_comm:
  for a: An3198
  for +b: An3198
  {aadd3198(a, b) == aadd3198(b, a) : An3198}

def aadd3198_comm(a, b):
  match a:
    case Az3198{}:
      %aadd3198_zero(b) : {_ == aadd3198(b, Az3198{}) : An3198}
      {==}
    case As3198{a}:
      %aadd3198_succ(b, a) : {As3198{aadd3198(a, b)} == _ : An3198}
      %aadd3198_comm(a, b) : {As3198{aadd3198(a, b)} == As3198{_} : An3198}
      {==}

