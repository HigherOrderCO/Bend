  for -v: Nat
  for c: Pair(Cpy(Nat, v), Cpy(Nat, v))
  Pair(Cpy(Ct890, Cl890{v}), Cpy(Ct890, Cl890{v}))

def Ct890.cpy.leaf(v, c):
  Tuple{Tuple{v1, e1}, Tuple{v2, e2}} = c
  Tuple{Tuple{Cl890{v1}, cong(Nat, Ct890, x => Cl890{x}, v, v1, e1)}, Tuple{Cl890{v2}, cong(Nat, Ct890, x => Cl890{x}, v, v2, e2)}}

