  for ys: Bl2140
  Bl2140

def bcat2140(xs, ys):
  match xs:
    case Bn2140{}:
      ys
    case Bc2140{h, t}:
      Bc2140{h, bcat2140(t, ys)}

law blen2140:
  for xs: Bl2140
  Nat

def blen2140(xs):
  match xs:
    case Bn2140{}:
      Z{}
    case Bc2140{h, t}:
      S{blen2140(t)}

law bcat2140_nil:
  for xs: Bl2140
  {bcat2140(xs, Bn2140{}) == xs : Bl2140}

def bcat2140_nil(xs):
  match xs:
    case Bn2140{}:
      {==}
    case Bc2140{h, t}:
      %bcat2140_nil(t) : {Bc2140{h, bcat2140(t, Bn2140{})} == Bc2140{h, _} : Bl2140}
      {==}

law bcat2140_assoc:
  for xs: Bl2140
  for -ys: Bl2140
  for -zs: Bl2140
  {bcat2140(bcat2140(xs, ys), zs) == bcat2140(xs, bcat2140(ys, zs)) : Bl2140}

def bcat2140_assoc(xs, ys, zs):
  match xs:
    case Bn2140{}:
      {==}
    case Bc2140{h, t}:
      %bcat2140_assoc(t, ys, zs) : {Bc2140{h, bcat2140(bcat2140(t, ys), zs)} == Bc2140{h, _} : Bl2140}
      {==}

law blen2140_cat:
  for xs: Bl2140
  for -ys: Bl2140
  {add(blen2140(xs), blen2140(ys)) == blen2140(bcat2140(xs, ys)) : Nat}

def blen2140_cat(xs, ys):
  match xs:
    case Bn2140{}:
      {==}
    case Bc2140{h, t}:
      %blen2140_cat(t, ys) : {S{add(blen2140(t), blen2140(ys))} == S{_} : Nat}
      {==}

type Ct2141 is Data:
  Cl2141{val: Nat}
  Cn2141{lft: Ct2141, rgt: Ct2141}

law cmir2141:
  for t: Ct2141
  Ct2141

def cmir2141(t):
  match t:
    case Cl2141{v}:
      Cl2141{v}
    case Cn2141{l, r}:
      Cn2141{cmir2141(r), cmir2141(l)}

law csize2141:
  for t: Ct2141
  Nat

def csize2141(t):
  match t:
    case Cl2141{v}:
      S{Z{}}
    case Cn2141{l, r}:
      add(csize2141(l), csize2141(r))

law Ct2141.cpy:
  for t: Ct2141
  Pair(Cpy(Ct2141, t), Cpy(Ct2141, t))

law Ct2141.cpy.leaf:
  for -v: Nat
  for c: Pair(Cpy(Nat, v), Cpy(Nat, v))
  Pair(Cpy(Ct2141, Cl2141{v}), Cpy(Ct2141, Cl2141{v}))

def Ct2141.cpy.leaf(v, c):
  Tuple{Tuple{v1, e1}, Tuple{v2, e2}} = c
  Tuple{Tuple{Cl2141{v1}, cong(Nat, Ct2141, x => Cl2141{x}, v, v1, e1)}, Tuple{Cl2141{v2}, cong(Nat, Ct2141, x => Cl2141{x}, v, v2, e2)}}

law Ct2141.cpy.node:
  for -l: Ct2141
  for -r: Ct2141
  for cl: Pair(Cpy(Ct2141, l), Cpy(Ct2141, l))
  for cr: Pair(Cpy(Ct2141, r), Cpy(Ct2141, r))
  Pair(Cpy(Ct2141, Cn2141{l, r}), Cpy(Ct2141, Cn2141{l, r}))

def Ct2141.cpy.node(l, r, cl, cr):
  Tuple{Tuple{l1, el1}, Tuple{l2, el2}} = cl
  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn2141{l1, r1}, Equal.cong2(Ct2141, Ct2141, Ct2141, x => y => Cn2141{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn2141{l2, r2}, Equal.cong2(Ct2141, Ct2141, Ct2141, x => y => Cn2141{x, y}, l, l2, r, r2, el2, er2)}}

def Ct2141.cpy(t):
  match t:
    case Cl2141{v}:
      Ct2141.cpy.leaf(v, Nat.cpy(v))
    case Cn2141{l, r}:
      Ct2141.cpy.node(l, r, Ct2141.cpy(l), Ct2141.cpy(r))

law cmir2141_mir:
  for t: Ct2141
  {cmir2141(cmir2141(t)) == t : Ct2141}

def cmir2141_mir(t):
  match t:
    case Cl2141{v}:
      {==}
    case Cn2141{l, r}:
      %cmir2141_mir(l) : {Cn2141{cmir2141(cmir2141(l)), cmir2141(cmir2141(r))} == Cn2141{_, r} : Ct2141}
      %cmir2141_mir(r) : {Cn2141{cmir2141(cmir2141(l)), cmir2141(cmir2141(r))} == Cn2141{cmir2141(cmir2141(l)), _} : Ct2141}
      {==}

law csize2141_mir:
  for +t: Ct2141
  {csize2141(cmir2141(t)) == csize2141(t) : Nat}

def csize2141_mir(t):
  match t:
    case Cl2141{v}:
      {==}
    case Cn2141{l, r}:
      %csize2141_mir(r) : {add(csize2141(cmir2141(r)), csize2141(cmir2141(l))) == add(csize2141(l), _) : Nat}
      %csize2141_mir(l) : {add(csize2141(cmir2141(r)), csize2141(cmir2141(l))) == add(_, csize2141(cmir2141(r))) : Nat}
      %add_comm(csize2141(cmir2141(l)), csize2141(cmir2141(r))) : {_ == add(csize2141(cmir2141(l)), csize2141(cmir2141(r))) : Nat}
      {==}

type An2142 is Data:
  Az2142{}
  As2142{pred: An2142}

