def An2142.cpy.succ(p, c):
  Tuple{Tuple{a, ea}, Tuple{b, eb}} = c
  Tuple{Tuple{As2142{a}, cong(An2142, An2142, x => As2142{x}, p, a, ea)}, Tuple{As2142{b}, cong(An2142, An2142, x => As2142{x}, p, b, eb)}}

def An2142.cpy(n):
  match n:
    case Az2142{}:
      Tuple{Tuple{Az2142{}, {==}}, Tuple{Az2142{}, {==}}}
    case As2142{p}:
      An2142.cpy.succ(p, An2142.cpy(p))

law aadd2142_zero:
  for a: An2142
  {aadd2142(a, Az2142{}) == a : An2142}

def aadd2142_zero(a):
  match a:
    case Az2142{}:
      {==}
    case As2142{a}:
      %aadd2142_zero(a) : {As2142{aadd2142(a, Az2142{})} == As2142{_} : An2142}
      {==}

law aadd2142_succ:
  for a: An2142
  for -b: An2142
  {As2142{aadd2142(a, b)} == aadd2142(a, As2142{b}) : An2142}

def aadd2142_succ(a, b):
  match a:
    case Az2142{}:
      {==}
    case As2142{a}:
      %aadd2142_succ(a, b) : {As2142{As2142{aadd2142(a, b)}} == As2142{_} : An2142}
      {==}

law aadd2142_comm:
  for a: An2142
  for +b: An2142
  {aadd2142(a, b) == aadd2142(b, a) : An2142}

def aadd2142_comm(a, b):
  match a:
    case Az2142{}:
      %aadd2142_zero(b) : {_ == aadd2142(b, Az2142{}) : An2142}
      {==}
    case As2142{a}:
      %aadd2142_succ(b, a) : {As2142{aadd2142(a, b)} == _ : An2142}
      %aadd2142_comm(a, b) : {As2142{aadd2142(a, b)} == As2142{_} : An2142}
      {==}

