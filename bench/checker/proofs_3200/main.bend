  Cn2729{lft: Ct2729, rgt: Ct2729}

law cmir2729:
  for t: Ct2729
  Ct2729

def cmir2729(t):
  match t:
    case Cl2729{v}:
      Cl2729{v}
    case Cn2729{l, r}:
      Cn2729{cmir2729(r), cmir2729(l)}

law csize2729:
  for t: Ct2729
  Nat

def csize2729(t):
  match t:
    case Cl2729{v}:
      S{Z{}}
    case Cn2729{l, r}:
      add(csize2729(l), csize2729(r))

law Ct2729.cpy:
  for t: Ct2729
  Pair(Cpy(Ct2729, t), Cpy(Ct2729, t))

law Ct2729.cpy.leaf:
  for -v: Nat
  for c: Pair(Cpy(Nat, v), Cpy(Nat, v))
  Pair(Cpy(Ct2729, Cl2729{v}), Cpy(Ct2729, Cl2729{v}))

def Ct2729.cpy.leaf(v, c):
  Tuple{Tuple{v1, e1}, Tuple{v2, e2}} = c
  Tuple{Tuple{Cl2729{v1}, cong(Nat, Ct2729, x => Cl2729{x}, v, v1, e1)}, Tuple{Cl2729{v2}, cong(Nat, Ct2729, x => Cl2729{x}, v, v2, e2)}}

law Ct2729.cpy.node:
  for -l: Ct2729
  for -r: Ct2729
  for cl: Pair(Cpy(Ct2729, l), Cpy(Ct2729, l))
  for cr: Pair(Cpy(Ct2729, r), Cpy(Ct2729, r))
  Pair(Cpy(Ct2729, Cn2729{l, r}), Cpy(Ct2729, Cn2729{l, r}))

def Ct2729.cpy.node(l, r, cl, cr):
  Tuple{Tuple{l1, el1}, Tuple{l2, el2}} = cl
  Tuple{Tuple{r1, er1}, Tuple{r2, er2}} = cr
  Tuple{Tuple{Cn2729{l1, r1}, Equal.cong2(Ct2729, Ct2729, Ct2729, x => y => Cn2729{x, y}, l, l1, r, r1, el1, er1)}, Tuple{Cn2729{l2, r2}, Equal.cong2(Ct2729, Ct2729, Ct2729, x => y => Cn2729{x, y}, l, l2, r, r2, el2, er2)}}

def Ct2729.cpy(t):
  match t:
    case Cl2729{v}:
      Ct2729.cpy.leaf(v, Nat.cpy(v))
    case Cn2729{l, r}:
      Ct2729.cpy.node(l, r, Ct2729.cpy(l), Ct2729.cpy(r))

law cmir2729_mir:
  for t: Ct2729
  {cmir2729(cmir2729(t)) == t : Ct2729}

def cmir2729_mir(t):
  match t:
    case Cl2729{v}:
      {==}
    case Cn2729{l, r}:
      %cmir2729_mir(l) : {Cn2729{cmir2729(cmir2729(l)), cmir2729(cmir2729(r))} == Cn2729{_, r} : Ct2729}
      %cmir2729_mir(r) : {Cn2729{cmir2729(cmir2729(l)), cmir2729(cmir2729(r))} == Cn2729{cmir2729(cmir2729(l)), _} : Ct2729}
      {==}

law csize2729_mir:
  for +t: Ct2729
  {csize2729(cmir2729(t)) == csize2729(t) : Nat}

def csize2729_mir(t):
  match t:
    case Cl2729{v}:
      {==}
    case Cn2729{l, r}:
      %csize2729_mir(r) : {add(csize2729(cmir2729(r)), csize2729(cmir2729(l))) == add(csize2729(l), _) : Nat}
      %csize2729_mir(l) : {add(csize2729(cmir2729(r)), csize2729(cmir2729(l))) == add(_, csize2729(cmir2729(r))) : Nat}
      %add_comm(csize2729(cmir2729(l)), csize2729(cmir2729(r))) : {_ == add(csize2729(cmir2729(l)), csize2729(cmir2729(r))) : Nat}
      {==}

type An2730 is Data:
  Az2730{}
  As2730{pred: An2730}

law aadd2730:
  for a: An2730
  for b: An2730
  An2730

def aadd2730(a, b):
  match a:
    case Az2730{}:
      b
    case As2730{a}:
      As2730{aadd2730(a, b)}

law An2730.cpy:
  for n: An2730
  Pair(Cpy(An2730, n), Cpy(An2730, n))

law An2730.cpy.succ:
  for -p: An2730
  for c: Pair(Cpy(An2730, p), Cpy(An2730, p))
  Pair(Cpy(An2730, As2730{p}), Cpy(An2730, As2730{p}))

def An2730.cpy.succ(p, c):
  Tuple{Tuple{a, ea}, Tuple{b, eb}} = c
  Tuple{Tuple{As2730{a}, cong(An2730, An2730, x => As2730{x}, p, a, ea)}, Tuple{As2730{b}, cong(An2730, An2730, x => As2730{x}, p, b, eb)}}

def An2730.cpy(n):
  match n:
    case Az2730{}:
      Tuple{Tuple{Az2730{}, {==}}, Tuple{Az2730{}, {==}}}
    case As2730{p}:
      An2730.cpy.succ(p, An2730.cpy(p))

law aadd2730_zero:
  for a: An2730
  {aadd2730(a, Az2730{}) == a : An2730}

def aadd2730_zero(a):
  match a:
    case Az2730{}:
      {==}
    case As2730{a}:
      %aadd2730_zero(a) : {As2730{aadd2730(a, Az2730{})} == As2730{_} : An2730}
      {==}

law aadd2730_succ:
  for a: An2730
  for -b: An2730
  {As2730{aadd2730(a, b)} == aadd2730(a, As2730{b}) : An2730}

def aadd2730_succ(a, b):
  match a:
    case Az2730{}:
      {==}
    case As2730{a}:
      %aadd2730_succ(a, b) : {As2730{As2730{aadd2730(a, b)}} == As2730{_} : An2730}
      {==}

law aadd2730_comm:
  for a: An2730
  for +b: An2730
  {aadd2730(a, b) == aadd2730(b, a) : An2730}

def aadd2730_comm(a, b):
  match a:
    case Az2730{}:
      %aadd2730_zero(b) : {_ == aadd2730(b, Az2730{}) : An2730}
      {==}
    case As2730{a}:
      %aadd2730_succ(b, a) : {As2730{aadd2730(a, b)} == _ : An2730}
      %aadd2730_comm(a, b) : {As2730{aadd2730(a, b)} == As2730{_} : An2730}
      {==}

