law An3150.cpy.succ:
  for -p: An3150
  for c: Pair(Cpy(An3150, p), Cpy(An3150, p))
  Pair(Cpy(An3150, As3150{p}), Cpy(An3150, As3150{p}))

def An3150.cpy.succ(p, c):
  Tuple{Tuple{a, ea}, Tuple{b, eb}} = c
  Tuple{Tuple{As3150{a}, cong(An3150, An3150, x => As3150{x}, p, a, ea)}, Tuple{As3150{b}, cong(An3150, An3150, x => As3150{x}, p, b, eb)}}

def An3150.cpy(n):
  match n:
    case Az3150{}:
      Tuple{Tuple{Az3150{}, {==}}, Tuple{Az3150{}, {==}}}
    case As3150{p}:
      An3150.cpy.succ(p, An3150.cpy(p))

law aadd3150_zero:
  for a: An3150
  {aadd3150(a, Az3150{}) == a : An3150}

def aadd3150_zero(a):
  match a:
    case Az3150{}:
      {==}
    case As3150{a}:
      %aadd3150_zero(a) : {As3150{aadd3150(a, Az3150{})} == As3150{_} : An3150}
      {==}

law aadd3150_succ:
  for a: An3150
  for -b: An3150
  {As3150{aadd3150(a, b)} == aadd3150(a, As3150{b}) : An3150}

def aadd3150_succ(a, b):
  match a:
    case Az3150{}:
      {==}
    case As3150{a}:
      %aadd3150_succ(a, b) : {As3150{As3150{aadd3150(a, b)}} == As3150{_} : An3150}
      {==}

law aadd3150_comm:
  for a: An3150
  for +b: An3150
  {aadd3150(a, b) == aadd3150(b, a) : An3150}

def aadd3150_comm(a, b):
  match a:
    case Az3150{}:
      %aadd3150_zero(b) : {_ == aadd3150(b, Az3150{}) : An3150}
      {==}
    case As3150{a}:
      %aadd3150_succ(b, a) : {As3150{aadd3150(a, b)} == _ : An3150}
      %aadd3150_comm(a, b) : {As3150{aadd3150(a, b)} == As3150{_} : An3150}
      {==}

