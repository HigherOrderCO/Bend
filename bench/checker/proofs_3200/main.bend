    case Bc1165{h, t}:
      %bcat1165_nil(t) : {Bc1165{h, bcat1165(t, Bn1165{})} == Bc1165{h, _} : Bl1165}
      {==}

law bcat1165_assoc:
  for xs: Bl1165
  for -ys: Bl1165
  for -zs: Bl1165
  {bcat1165(bcat1165(xs, ys), zs) == bcat1165(xs, bcat1165(ys, zs)) : Bl1165}

