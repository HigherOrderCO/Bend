  Bc1930{head: Nat, tail: Bl1930}

law bcat1930:
  for xs: Bl1930
  for ys: Bl1930
  Bl1930

def bcat1930(xs, ys):
  match xs:
    case Bn1930{}:
      ys
    case Bc1930{h, t}:
      Bc1930{h, bcat1930(t, ys)}

law blen1930:
  for xs: Bl1930
  Nat

def blen1930(xs):
  match xs:
    case Bn1930{}:
      Z{}
    case Bc1930{h, t}:
      S{blen1930(t)}

law bcat1930_nil:
  for xs: Bl1930
  {bcat1930(xs, Bn1930{}) == xs : Bl1930}

def bcat1930_nil(xs):
  match xs:
    case Bn1930{}:
      {==}
    case Bc1930{h, t}:
      %bcat1930_nil(t) : {Bc1930{h, bcat1930(t, Bn1930{})} == Bc1930{h, _} : Bl1930}
      {==}

law bcat1930_assoc:
  for xs: Bl1930
  for -ys: Bl1930
  for -zs: Bl1930
  {bcat1930(bcat1930(xs, ys), zs) == bcat1930(xs, bcat1930(ys, zs)) : Bl1930}

def bcat1930_assoc(xs, ys, zs):
  match xs:
    case Bn1930{}:
      {==}
    case Bc1930{h, t}:
      %bcat1930_assoc(t, ys, zs) : {Bc1930{h, bcat1930(bcat1930(t, ys), zs)} == Bc1930{h, _} : Bl1930}
      {==}

law blen1930_cat:
  for xs: Bl1930
  for -ys: Bl1930
  {add(blen1930(xs), blen1930(ys)) == blen1930(bcat1930(xs, ys)) : Nat}

def blen1930_cat(xs, ys):
  match xs:
    case Bn1930{}:
      {==}
    case Bc1930{h, t}:
      %blen1930_cat(t, ys) : {S{add(blen1930(t), blen1930(ys))} == S{_} : Nat}
      {==}

