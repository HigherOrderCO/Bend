law cong:
  for -A: Type
  for -B: Type
  for -f: A -> B
  for -a: A
  for -b: A
  for  e: {a == b : A}
  {f(a) == f(b) : B}

def cong(A, B, f, a, b, e):
  %e : {f(a) == f(_) : B}
  {==}

type Nat is Data:
  Z{}
  S{pred: Nat}

type Sigma<-A: Type, -B: @-x: A -> Type> is Type:
  Tuple{fst: A, snd: B(fst)}

law Pair:
  for -A: Type
  for -B: Type
  Type

def Pair(A, B):
  Sigma<A, _ => B>

law Cpy:
  for -A: Type
  for -x: A
  Type

def Cpy(A, x):
  Sigma<A, y => {x == y : A}>

law Cpyable:
  for -T: Type
  Type

def Cpyable(T):
  @x: T -> Pair(Cpy(T, x), Cpy(T, x))

law Equal.cong2:
  for -A: Type
  for -B: Type
  for -C: Type
  for -f: A -> @y: B -> C
  for -a: A
  for -c: A
  for -b: B
  for -d: B
  for ea: {a == c : A}
  for eb: {b == d : B}
  {f(a)(b) == f(c)(d) : C}

def Equal.cong2(A, B, C, f, a, c, b, d, ea, eb):
  %eb : {f(a)(b) == f(c)(_) : C}
  %ea : {f(a)(b) == f(_)(b) : C}
  {==}

law add:
  for a: Nat
  for b: Nat
  Nat

def add(a, b):
  match a:
    case Z{}:
      b
    case S{a}:
      S{add(a, b)}

law Nat.cpy:
  for n: Nat
  Pair(Cpy(Nat, n), Cpy(Nat, n))

law Nat.cpy.succ:
  for -p: Nat
  for c: Pair(Cpy(Nat, p), Cpy(Nat, p))
  Pair(Cpy(Nat, S{p}), Cpy(Nat, S{p}))

def Nat.cpy.succ(p, c):
  Tuple{Tuple{a, ea}, Tuple{b, eb}} = c
  Tuple{Tuple{S{a}, cong(Nat, Nat, x => S{x}, p, a, ea)}, Tuple{S{b}, cong(Nat, Nat, x => S{x}, p, b, eb)}}

def Nat.cpy(n):
  match n:
    case Z{}:
      Tuple{Tuple{Z{}, {==}}, Tuple{Z{}, {==}}}
    case S{p}:
      Nat.cpy.succ(p, Nat.cpy(p))

law mul:
  for a: Nat
  for +b: Nat
  Nat

def mul(a, b):
  match a:
    case Z{}:
      Z{}
    case S{a}:
      add(b, mul(a, b))

law dbl:
  for +x: Nat
  Nat

def dbl(x):
  add(x, x)

type L is Data:
  Ln{}
  Lc{head: Nat, tail: L}

law cat:
  for xs: L
  for ys: L
  L

def cat(xs, ys):
  match xs:
    case Ln{}:
      ys
    case Lc{h, t}:
      Lc{h, cat(t, ys)}

law fa0:
  for x: Nat
  Nat

def fa0(x):
  match x:
    case Z{}:
      dbl(S{Z{}})
    case S{q}:
      S{fa0(q)}

law ga0:
  for x: Nat
  for y: Nat
  Nat

def ga0(x, y):
  add(fa0(x), dbl(y))

law fb1:
  for xs: L
  L

def fb1(xs):
  match xs:
    case Ln{}:
      Ln{}
    case Lc{h, t}:
      Lc{fa0(h), fb1(t)}

law fc2:
  for xs: L
  Nat

def fc2(xs):
  match xs:
    case Ln{}:
      Z{}
    case Lc{h, t}:
      add(fa0(h), fc2(t))

law gc2:
  for +x: Nat
  Nat

def gc2(x):
  fc2(Lc{x, Lc{fa0(x), Ln{}}})

