def invoke(w: Wrapped, x: Nat) -> Nat:
  match w:
    case Wrap{f}:
      f(x)

def consume(+s: String) -> IO(Unit):
  result = invoke(close(s), 7n)
  expected = Nat.add(Nat.mul(String.length(s), 46950n), 135085n)
  IO.print(Bool.show(Cmp.is_eq(Nat.cmp(result, expected))))

def main() -> IO(Unit):
  do IO<Unit>:
    t: Nat <- IO.now()
    consume(Nat.show(t))

#|True
