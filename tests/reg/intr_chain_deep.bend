# regression witness: 100 nested U32 operators and 140 F32 ones build in C.
# One C expression passed clang's nesting limit of 256 at 86 U32 ops (#1123).
import Base

def u(+a: U32, +b: U32) -> U32:
  ((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((
    ((((((((((((((((((((((((((a + b : U32) .^. a : U32) - b : U32) * a : U32)
    + b : U32) .^. a : U32) - b : U32) * a : U32) + b : U32) .^. a : U32)
    - b : U32) * a : U32) + b : U32) .^. a : U32) - b : U32) * a : U32)
    + b : U32) .^. a : U32) - b : U32) * a : U32) + b : U32) .^. a : U32)
    - b : U32) * a : U32) + b : U32) .^. a : U32) - b : U32) * a : U32)
    + b : U32) .^. a : U32) - b : U32) * a : U32) + b : U32) .^. a : U32)
    - b : U32) * a : U32) + b : U32) .^. a : U32) - b : U32) * a : U32)
    + b : U32) .^. a : U32) - b : U32) * a : U32) + b : U32) .^. a : U32)
    - b : U32) * a : U32) + b : U32) .^. a : U32) - b : U32) * a : U32)
    + b : U32) .^. a : U32) - b : U32) * a : U32) + b : U32) .^. a : U32)
    - b : U32) * a : U32) + b : U32) .^. a : U32) - b : U32) * a : U32)
    + b : U32) .^. a : U32) - b : U32) * a : U32) + b : U32) .^. a : U32)
    - b : U32) * a : U32) + b : U32) .^. a : U32) - b : U32) * a : U32)
    + b : U32) .^. a : U32) - b : U32) * a : U32) + b : U32) .^. a : U32)
    - b : U32) * a : U32) + b : U32) .^. a : U32) - b : U32) * a : U32)
    + b : U32) .^. a : U32) - b : U32) * a : U32) + b : U32) .^. a : U32)
    - b : U32) * a : U32) + b : U32) .^. a : U32) - b : U32) * a : U32)

def f(+a: F32, +b: F32) -> F32:
  ((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((
    ((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((((a
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32) - b : F32) + b : F32) * a : F32) - b : F32)
    + b : F32) * a : F32)

def main() -> IO(Unit):
  do IO<Unit>:
    Unit <- IO.print(U32.show(u(5, 7)))
    IO.print(F32.show(f(1.5, 0.5)))

