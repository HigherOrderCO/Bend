# Keep the digits and sign when the decimal point moves.
import Base

def show(xs: List<&2, F32>) -> IO(Unit):
  IO.print(List.show(~&2, ~F32, ~F32.show, xs))

def main() -> IO(Unit):
  do IO<Unit>:
    show([0.0, F32.neg(0.0), 1.0, F32.neg(1.0)])
    show([0.125, 1.25, 12.5, 125.0, 1250.0])
    show([F32.neg(0.125), F32.neg(1.25), F32.neg(12.5)])
    show([0.1, 0.00125, 0.000001, 0.0000001])
    show([F32.neg(0.00125), F32.neg(0.000001), F32.neg(0.0000001)])
    show([1.2345678, 123456.78, 100000000000000000000.0, 1.0e21])
    show([F32.div(1.0, 0.0), F32.div(F32.neg(1.0), 0.0), F32.div(0.0, 0.0)])

#|[0, -0, 1, -1]
#|[0.125, 1.25, 12.5, 125, 1250]
#|[-0.125, -1.25, -12.5]
#|[0.1, 0.00125, 0.000001, 1e-7]
#|[-0.00125, -0.000001, -1e-7]
#|[1.2345678, 123456.78, 100000000000000000000, 1e+21]
#|[inf, -inf, nan]
