# Nat's ops and U32.to_nat run as native C and JS (comp.ts
# OPERATIONS), not as Base's defs. Nat.pow has no native: it runs
# Base's def on every lane.
# model proves by {==} that the calls equal these values in Base's defs,
# so --verdict pins the model; main prints the same calls, so every lane
# must print what the model computes. The values are each lane's answers.
import Base

def calls() -> List<Nat>:
  [
    Nat.add(0n, 0n),
    Nat.add(0n, 7n),
    Nat.add(7n, 0n),
    Nat.add(3n, 10n),
    Nat.add(10n, 3n),
    Nat.add(31n, 64n),
    Nat.add(100n, 7n),
    Nat.add(64n, 64n),
    Nat.sub(0n, 0n),
    Nat.sub(0n, 7n),
    Nat.sub(7n, 0n),
    Nat.sub(3n, 10n),
    Nat.sub(10n, 3n),
    Nat.sub(31n, 64n),
    Nat.sub(100n, 7n),
    Nat.sub(64n, 64n),
    Nat.mul(0n, 0n),
    Nat.mul(0n, 7n),
    Nat.mul(7n, 0n),
    Nat.mul(3n, 10n),
    Nat.mul(10n, 3n),
    Nat.mul(31n, 64n),
    Nat.mul(100n, 7n),
    Nat.mul(64n, 64n),
    Nat.div(0n, 0n),
    Nat.div(0n, 7n),
    Nat.div(7n, 0n),
    Nat.div(3n, 10n),
    Nat.div(10n, 3n),
    Nat.div(31n, 64n),
    Nat.div(100n, 7n),
    Nat.div(64n, 64n),
    Nat.mod(0n, 0n),
    Nat.mod(0n, 7n),
    Nat.mod(7n, 0n),
    Nat.mod(3n, 10n),
    Nat.mod(10n, 3n),
    Nat.mod(31n, 64n),
    Nat.mod(100n, 7n),
    Nat.mod(64n, 64n),
    Nat.min(0n, 0n),
    Nat.min(0n, 7n),
    Nat.min(7n, 0n),
    Nat.min(3n, 10n),
    Nat.min(10n, 3n),
    Nat.min(31n, 64n),
    Nat.min(100n, 7n),
    Nat.min(64n, 64n),
    Nat.max(0n, 0n),
    Nat.max(0n, 7n),
    Nat.max(7n, 0n),
    Nat.max(3n, 10n),
    Nat.max(10n, 3n),
    Nat.max(31n, 64n),
    Nat.max(100n, 7n),
    Nat.max(64n, 64n),
    Nat.double(0n),
    Nat.double(7n),
    Nat.double(100n),
    Nat.pow(0n, 0n),
    Nat.pow(2n, 5n),
    Nat.pow(3n, 3n),
    U32.to_nat(0),
    U32.to_nat(255),
    U32.to_nat(1000)
  ]

def model() -> {calls() == [
    0n,
    7n,
    7n,
    13n,
    13n,
    95n,
    107n,
    128n,
    0n,
    0n,
    7n,
    0n,
    7n,
    0n,
    93n,
    0n,
    0n,
    0n,
    0n,
    30n,
    30n,
    1984n,
    700n,
    4096n,
    0n,
    0n,
    0n,
    0n,
    3n,
    0n,
    14n,
    1n,
    0n,
    0n,
    7n,
    3n,
    1n,
    31n,
    2n,
    0n,
    0n,
    0n,
    0n,
    3n,
    3n,
    31n,
    7n,
    64n,
    0n,
    7n,
    7n,
    10n,
    10n,
    64n,
    100n,
    64n,
    0n,
    14n,
    200n,
    1n,
    32n,
    27n,
    0n,
    255n,
    1000n
  ] : List<Nat>}:
  {==}

def main() -> List<Nat>:
  calls()

#|[0n, 7n, 7n, 13n, 13n, 95n, 107n, 128n, 0n, 0n, 7n, 0n, 7n, 0n, 93n, 0n, 0n, 0n, 0n, 30n, 30n, 1984n, 700n, 4096n, 0n, 0n, 0n, 0n, 3n, 0n, 14n, 1n, 0n, 0n, 7n, 3n, 1n, 31n, 2n, 0n, 0n, 0n, 0n, 3n, 3n, 31n, 7n, 64n, 0n, 7n, 7n, 10n, 10n, 64n, 100n, 64n, 0n, 14n, 200n, 1n, 32n, 27n, 0n, 255n, 1000n]
