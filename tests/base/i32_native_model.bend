# I32's ops run as native C and JS (comp.ts OPERATIONS), not as Base's
# defs: the ones that read no sign share U32's natives, the rest read the
# word as two's complement. model proves by {==} that the calls' words equal
# these in Base's defs, so --verdict pins the model; main prints the same
# calls, so every lane must print what the model computes.
import Base

def lo() -> I32:
  I32.sub(I32.neg(2147483647i), 1i)

def ord(c: Cmp) -> I32:
  match c:
    case LT{}:
      I32.neg(1i)
    case EQ{}:
      0i
    case GT{}:
      1i

def bits(xs: List<I32>) -> List<U32>:
  match xs:
    case Nil{}:
      []
    case Con{x, t}:
      Con{I32.to_u32(x), bits(t)}

