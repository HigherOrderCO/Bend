+# Generated destination entries must not collide with user definitions.
+# even~dst and the user name even_dst sanitize to the same identifier.
+import Base
+
+type Chain is Data:
+  End{}
+  Link{tail: Chain}
+
+@unsafe
+def even(n: Nat) -> Chain:
+  match n:
+    case 0n:
+      End{}
+    case 1n+p:
+      t = even_dst(p)
+      Link{t}
+
+@unsafe
+def even_dst(n: Nat) -> Chain:
+  match n:
+    case 0n:
+      End{}
+    case 1n+p:
+      t = even(p)
+      Link{t}
+
+def length(t: Chain, n: Nat) -> Nat:
+  match t:
+    case End{}:
+      n
+    case Link{t}:
+      length(t, Nat.add(n, 1n))
+
+def main() -> IO(Unit):
+  t = even!(256n)
+  IO.print(Nat.show(length!(t, 0n)))
+
+#|256
